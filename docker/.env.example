# --- Prebuilt GHCR image (default) ---
# Available profiles: blog-sqlite | blog-pg-valkey
# For local build or mainland China mirrors, layer compose.build.yml instead.
EMDASH_IMAGE=ghcr.io/web-casa/emdash-deploy:1.6.0-hi.5-blog-sqlite

# --- Multi-instance identity (change these to run multiple sites on one host) ---
COMPOSE_PROJECT_NAME=emdash-blog
APP_BIND_IP=127.0.0.1
APP_PORT=3000

# --- Public origin (CRITICAL for EmDash Passkey / WebAuthn & OAuth) ---
EMDASH_SITE_URL=http://127.0.0.1:3000
TIMEZONE=Asia/Shanghai

# --- EmDash 1.6 template & runtime drivers ---
# Templates: blog | marketing | portfolio
EMDASH_TEMPLATE=blog
# DB_DRIVER: sqlite | postgres
DB_DRIVER=sqlite
# SESSION_DRIVER: file | redis
SESSION_DRIVER=file
# STORAGE_DRIVER: local | s3
STORAGE_DRIVER=local
# Enable @emdash-cms/sandbox-workerd plugin isolation (1 or 0)
ENABLE_PLUGIN_SANDBOX=1
# Automatically apply pending EmDash migrations on startup (1 or 0)
EMDASH_AUTO_MIGRATE=1

# --- Cryptographic secrets ---
# Generate once with: docker compose run --rm emdash secrets-generate
# IMPORTANT: Keep and back up this key! Losing it makes encrypted plugin settings unrecoverable.
EMDASH_ENCRYPTION_KEY=

# --- Optional: PostgreSQL 18 (enable with --profile postgres) ---
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# PG_DB_NAME=emdash
# PG_DB_USER=emdash
# PG_DB_PASSWORD=change-me-strong-pg-password

# --- Optional: Valkey sessions (enable with --profile valkey) ---
# REDIS_PASSWORD=change-me-strong-valkey-password
# REDIS_URL=redis://:change-me-strong-valkey-password@valkey:6379/0

# --- Optional: S3-compatible media storage (when STORAGE_DRIVER=s3) ---
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_BUCKET=emdash-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=

# --- Optional: Mainland China build mirrors ---
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
# COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
# EMDASH_TEMPLATES_REPO=https://gh-proxy.com/https://github.com/emdash-cms/templates.git
# Fast-fail unreachable Google Fonts metadata requests during build (~90-120s faster in China):
# EMDASH_FAST_FAIL_GOOGLE_FONTS=1

# --- Optional: Host UID/GID alignment for bind mounts ---
# PUID=10001
# PGID=10001
