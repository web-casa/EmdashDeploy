log() { printf '[INFO] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*" >&2; }
fail() { printf '[ERROR] %s\n' "$*" >&2; exit 1; }

usage() {
	cat <<EOF
emdashctl

$(ct usage_title)
  emdashctl [--lang <code>] instances [--json]
  emdashctl [--lang <code>] [--instance <name>] status [--json]
  emdashctl [--lang <code>] [--instance <name>] doctor [--deep] [--json]
  emdashctl [--lang <code>] [--instance <name>] diagnose [--json] [--lines <N>] [--out <file>] [--no-ip-redact]
  emdashctl [--lang <code>] [--instance <name>] smoke [--json]
  emdashctl [--lang <code>] [--instance <name>] logs [app|postgres|redis|caddy] [-f]
  emdashctl [--lang <code>] [--instance <name>] restart [app|postgres|redis|all|caddy]
  emdashctl [--lang <code>] [--instance <name>] backup [--full] [--encrypt] [--list-s3]
  emdashctl [--lang <code>] [--instance <name>] restore <backup-file | --from-s3 <key|latest>> [--with-site] [--with-secrets] [--yes]
  emdashctl [--lang <code>] [--instance <name>] upgrade app [--target <version|latest>] [--dry-run] [--skip-backup] [--yes]
  emdashctl [--lang <code>] [--instance <name>] upgrade caddy-config
  emdashctl [--lang <code>] [--instance <name>] template diff [--stat]
  emdashctl [--lang <code>] [--instance <name>] rotate-encryption-key [--status [--json] | --dry-run [--yes] | --prune-old [--confirm-prune-kid <kid>] [--force-prune] [--dry-run]]
  emdashctl [--lang <code>] [--instance <name>] migrate-db sqlite-to-postgres [--pg-host <h>] [--pg-port <p>] [--pg-db <db>] [--pg-user <u>] [--pg-password-file <file>] [--truncate-target] [--dry-run] [--yes]
  emdashctl [--lang <code>] [--instance <name>] reset-db-password
  emdashctl [--lang <code>] [--instance <name>] uninstall [--purge-data] [--drop-db] [--confirm-instance <name>] [--yes]
EOF
}

validate_ctl_instance_name() {
	local name="${1:-}"
	[[ -n "${name}" ]] || return 0
	if [[ "${name}" == "default" ]]; then
		return 0
	fi
	if ! [[ "${name}" =~ ^[a-z][a-z0-9-]{0,31}$ ]]; then
		fail "Invalid instance name '${name}' (must match ^[a-z][a-z0-9-]{0,31}$)"
	fi
}

PARSED_ARGS=()

parse_lang_args() {
	PARSED_ARGS=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--lang=*)
			EMDASH_INSTALL_LANG="$(normalize_ctl_lang "${1#--lang=}")"
			;;
		--lang)
			shift
			[[ $# -gt 0 ]] || fail "Missing value for --lang"
			EMDASH_INSTALL_LANG="$(normalize_ctl_lang "$1")"
			;;
		--instance=*)
			INSTANCE_NAME="${1#--instance=}"
			validate_ctl_instance_name "${INSTANCE_NAME}"
			[[ "${INSTANCE_NAME}" == "default" ]] && INSTANCE_NAME=""
			;;
		--instance)
			shift
			[[ $# -gt 0 ]] || fail "Missing value for --instance"
			INSTANCE_NAME="$1"
			validate_ctl_instance_name "${INSTANCE_NAME}"
			[[ "${INSTANCE_NAME}" == "default" ]] && INSTANCE_NAME=""
			;;
		*)
			PARSED_ARGS+=("$1")
			;;
		esac
		shift || true
	done
}

resolve_env_file_for_instance() {
	local base_etc="${EMDASH_INSTANCES_BASE_DIR:-/etc/emdash}"
	if [[ -n "${EMDASH_INSTALL_ENV_FILE:-}" ]]; then
		ENV_FILE="${EMDASH_INSTALL_ENV_FILE}"
		return
	fi
	if [[ -n "${INSTANCE_NAME:-}" ]]; then
		ENV_FILE="${base_etc}/instances/${INSTANCE_NAME}/emdash.env"
	elif [[ -z "${ENV_FILE:-}" || "${ENV_FILE}" == "/etc/emdash/emdash.env" ]]; then
		ENV_FILE="${base_etc}/emdash.env"
	fi
}

load_site_common() {
	local candidate=""
	for candidate in \
		"${ROOT_DIR:-}/lib/site-common.sh" \
		"${EMDASHCTL_SCRIPT_DIR}/lib/site-common.sh"; do
		if [[ -n "${candidate}" && -f "${candidate}" ]]; then
			# shellcheck disable=SC1090
			source "${candidate}"
			return 0
		fi
	done
	return 1
}

load_env() {
	local caller_backup_passphrase="${BACKUP_ENCRYPTION_PASSPHRASE:-}"
	resolve_env_file_for_instance
	[[ -f "${ENV_FILE}" ]] || fail "$(ct missing_env): ${ENV_FILE}"
	set -a
	# shellcheck disable=SC1090
	source "${ENV_FILE}"
	set +a
	if [[ -n "${caller_backup_passphrase}" ]]; then
		BACKUP_ENCRYPTION_PASSPHRASE="${caller_backup_passphrase}"
	fi
	INSTANCE_NAME="${INSTANCE_NAME:-}"
	INSTANCE_SLUG="${INSTANCE_SLUG:-${INSTANCE_NAME:-default}}"
	CONFIG_DIR="${CONFIG_DIR:-$(dirname "${ENV_FILE}")}"
	ROOT_DIR="${ROOT_DIR:-$([[ -n "${INSTANCE_NAME}" ]] && printf '/data/emdash-%s' "${INSTANCE_NAME}" || printf '/data/emdash')}"
	APP_ENV_FILE="${APP_ENV_FILE:-${ENV_FILE}}"
	INSTALL_YAML="${INSTALL_YAML:-${CONFIG_DIR}/install.yml}"
	SITE_DIR="${SITE_DIR:-${ROOT_DIR}/app/site}"
	SCRIPTS_DIR="${SCRIPTS_DIR:-${ROOT_DIR}/scripts}"
	TMP_DIR="${TMP_DIR:-${ROOT_DIR}/tmp}"
	BACKUP_DIR="${BACKUP_DIR:-${ROOT_DIR}/backups}"
	UPLOADS_DIR="${UPLOADS_DIR:-${ROOT_DIR}/data/uploads}"
	SESSIONS_DIR="${SESSIONS_DIR:-${ROOT_DIR}/data/sessions}"
	SQLITE_DIR="${SQLITE_DIR:-${ROOT_DIR}/data/sqlite}"
	SQLITE_PATH="${SQLITE_PATH:-${SQLITE_DIR}/data.db}"
	APP_SYSTEMD_SERVICE="${APP_SYSTEMD_SERVICE:-$([[ -n "${INSTANCE_NAME}" ]] && printf 'emdash-app-%s' "${INSTANCE_NAME}" || printf 'emdash-app')}"
	APP_SYSTEMD_UNIT="${APP_SYSTEMD_UNIT:-/etc/systemd/system/${APP_SYSTEMD_SERVICE}.service}"
	APP_BUILD_SCRIPT="${APP_BUILD_SCRIPT:-${SCRIPTS_DIR}/emdash-build.sh}"
	APP_START_SCRIPT="${APP_START_SCRIPT:-${SCRIPTS_DIR}/emdash-start.sh}"
	CADDYFILE_PATH="${CADDYFILE_PATH:-/etc/emdash/caddy/Caddyfile}"
	CADDY_SITES_DIR="${CADDY_SITES_DIR:-/etc/emdash/caddy/sites.d}"
	CADDY_CONF_DIR="${CADDY_CONF_DIR:-/etc/emdash/caddy/conf.d}"
	CADDY_SITE_FILE="${CADDY_SITE_FILE:-${CADDY_SITES_DIR}/${INSTANCE_SLUG}.caddy}"
	BACKUP_CRON_FILE="${BACKUP_CRON_FILE:-$([[ -n "${INSTANCE_NAME}" ]] && printf '/etc/cron.d/emdash-backup-%s' "${INSTANCE_NAME}" || printf '/etc/cron.d/emdash-backup')}"
	BACKUP_KEEP_S3="${BACKUP_KEEP_S3:-14}"
	ENABLE_PLUGIN_SANDBOX="${ENABLE_PLUGIN_SANDBOX:-1}"
	BACKUP_ENABLED="${BACKUP_ENABLED:-1}"
	BACKUP_TARGET_TYPE="${BACKUP_TARGET_TYPE:-local}"
	USE_CADDY="${USE_CADDY:-0}"
	ENABLE_HTTPS="${ENABLE_HTTPS:-0}"
	DB_DRIVER="${DB_DRIVER:-sqlite}"
	SESSION_DRIVER="${SESSION_DRIVER:-file}"
	STORAGE_DRIVER="${STORAGE_DRIVER:-local}"
	APP_PORT="${APP_PORT:-3000}"
	APP_RUN_USER="${APP_RUN_USER:-emdash}"
	APP_RUN_GROUP="${APP_RUN_GROUP:-emdash}"
	load_site_common || true
}

acquire_op_lock() {
	local lock_name="emdashctl-${INSTANCE_SLUG:-default}.lock"
	local lock_file="/run/lock/${lock_name}"
	if [[ ! -d /run/lock || ! -w /run/lock ]]; then
		mkdir -p "${TMP_DIR}"
		lock_file="${TMP_DIR}/${lock_name}"
	fi
	exec 9>"${lock_file}"
	if ! flock -n 9; then
		fail "Another emdashctl operation is currently running (lock: ${lock_file})."
	fi
}

release_op_lock() {
	exec 9>&- 2>/dev/null || true
}

bool_active() {
	systemctl is-active --quiet "$1" 2>/dev/null
}

service_name_for() {
	case "${1:-app}" in
	app) printf '%s\n' "${APP_SYSTEMD_SERVICE}" ;;
	postgres) printf '%s\n' "${POSTGRES_SERVICE}" ;;
	redis) printf '%s\n' "${REDIS_SERVICE}" ;;
	caddy) printf 'caddy\n' ;;
	*) return 1 ;;
	esac
}

local_health_url() {
	printf 'http://127.0.0.1:%s/healthz\n' "${APP_PORT:-3000}"
}

local_setup_url() {
	printf 'http://127.0.0.1:%s/_emdash/api/setup/status\n' "${APP_PORT:-3000}"
}

wait_http_ok() {
	local url="$1" tries="${2:-60}" i
	for ((i=1; i<=tries; i++)); do
		if curl -fsS --max-time 5 "${url}" >/dev/null 2>&1; then
			return 0
		fi
		sleep 2
	done
	return 1
}

run_as_app_user() {
	local cmd="$1"
	local env_prefix=""
	if [[ -n "${ROOT_DIR:-}" && -d "${ROOT_DIR}" ]]; then
		env_prefix="export HOME='${ROOT_DIR}'; "
	fi
	if [[ "$(id -un)" == "${APP_RUN_USER}" ]]; then
		bash -lc "${env_prefix}${cmd}"
		return
	fi
	runuser -u "${APP_RUN_USER}" -- bash -lc "${env_prefix}${cmd}"
}

emdash_bin_cmd() {
	if [[ -x "${SITE_DIR}/node_modules/.bin/emdash" ]]; then
		printf "'%s/node_modules/.bin/emdash'" "${SITE_DIR}"
	else
		printf 'COREPACK_ENABLE_DOWNLOAD_PROMPT=0 pnpm exec emdash'
	fi
}

update_env_value() {
	local key="$1"
	local value="$2"
	local file="${3:-${APP_ENV_FILE}}"
	if declare -F update_env_file_value >/dev/null 2>&1; then
		update_env_file_value "${key}" "${value}" "${file}"
		return
	fi
	KEY="${key}" VALUE="${value}" TARGET_FILE="${file}" python3 <<'PY'
from pathlib import Path
import os

def quote(value: str) -> str:
    value = value.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$").replace("`", "\\`").replace("\n", "\\n")
    return f'"{value}"'

path = Path(os.environ["TARGET_FILE"])
key = os.environ["KEY"]
value = os.environ["VALUE"]
lines = []
updated = False
if path.exists():
    for raw in path.read_text().splitlines():
        if raw.startswith(f"{key}="):
            lines.append(f"{key}={quote(value)}")
            updated = True
        else:
            lines.append(raw)
if not updated:
    lines.append(f"{key}={quote(value)}")
path.write_text("\n".join(lines) + "\n")
PY
}

redact_sensitive_text() {
	EMDASH_REDACT_IPS="${EMDASH_REDACT_IPS:-1}" \
	PG_DB_PASSWORD="${PG_DB_PASSWORD:-}" \
	REDIS_PASSWORD="${REDIS_PASSWORD:-}" \
	EMDASH_ENCRYPTION_KEY="${EMDASH_ENCRYPTION_KEY:-}" \
	EMDASH_AUTH_SECRET="${EMDASH_AUTH_SECRET:-}" \
	EMDASH_PREVIEW_SECRET="${EMDASH_PREVIEW_SECRET:-}" \
	S3_SECRET_ACCESS_KEY="${S3_SECRET_ACCESS_KEY:-}" \
	BACKUP_S3_SECRET_ACCESS_KEY="${BACKUP_S3_SECRET_ACCESS_KEY:-}" \
	BACKUP_ENCRYPTION_PASSPHRASE="${BACKUP_ENCRYPTION_PASSPHRASE:-}" \
	python3 -c '
import os, re, sys

text = sys.stdin.read()
redact_ips = os.environ.get("EMDASH_REDACT_IPS", "1") == "1"

# EmDash encryption key specs
text = re.sub(r"emdash_enc_v1_[A-Za-z0-9_-]{43}", "emdash_enc_v1_[REDACTED]", text)
# Database / Redis URLs with credentials
text = re.sub(r"(postgres|postgresql|redis|rediss)://([^:@/\s\"\x27]*):([^@/\s\"\x27]+)@", r"\1://\2:[REDACTED]@", text)
# JWT tokens (header.payload.signature)
text = re.sub(r"\beyJ[A-Za-z0-9_-]{6,}\.[A-Za-z0-9_-]{6,}\.[A-Za-z0-9_-]{6,}\b", "[REDACTED_JWT]", text)
# HTTP Authorization headers (plain, JSON-serialized, and escaped JSON-in-JSON; idempotent)
text = re.sub(r"(?i)(\b(?:bearer|basic)\s+)(?!\[REDACTED)[A-Za-z0-9._~+/=-]{8,}", r"\1[REDACTED]", text)
text = re.sub(r"(?i)(authorization\s*[:=]\s*\\?[\"'\'']?(?:bearer|basic|token)\s+)(?!\[REDACTED)[^\s\"'\'',;\]\}\\]+", r"\1[REDACTED]", text)
text = re.sub(r"(?i)(\\?\"authorization\\?\"\s*:\s*\[?\s*\\?\")((?:bearer|basic|token)\s+)(?!\[REDACTED)[^\"\\]+(\\?\")", r"\1\2[REDACTED]\3", text)
# Cookie / Set-Cookie headers (plain, JSON-serialized, and escaped JSON-in-JSON; idempotent)
text = re.sub(
    r"(?i)((\\?)\"(?:set-cookie|cookie)\2\"\s*:\s*)\[(?!\s*\\?\"\[REDACTED)[^\]]*\]",
    lambda m: f"{m.group(1)}[{m.group(2)}\"[REDACTED_COOKIE]{m.group(2)}\"]",
    text,
)
text = re.sub(r"(?i)((\\?)\"(?:set-cookie|cookie)\2\"\s*:\s*)(\2\")(?!\[REDACTED)[^\"\\]*\3", r"\1\3[REDACTED_COOKIE]\3", text)
text = re.sub(r"(?im)^(\s*(?:set-cookie|cookie)\s*:\s*)(?!\[REDACTED).+$", r"\1[REDACTED_COOKIE]", text)
text = re.sub(r"(?i)\b((?:set-cookie|cookie)\s*:\s*)(?!\[REDACTED)[^\r\n\"}\]]+", r"\1[REDACTED_COOKIE]", text)
# Sensitive URL query params (idempotent)
text = re.sub(
    r"(?i)([?&](?:token|access_token|refresh_token|api_key|apikey|key|secret|password|passwd|pwd|code|signature|sig|auth)=)(?!\[REDACTED)([^&#\s\"'\''\)\]\\]+)",
    r"\1[REDACTED]",
    text,
)

if redact_ips:
    text = re.sub(r"(?i)((\\?)\"(?:remote_ip|client_ip|remote_addr)\2\"\s*:\s*)(\2\")(?!\[REDACTED)[^\"\\]+\3", r"\1\3[REDACTED_IP]\3", text)
    text = re.sub(
        r"(?i)((\\?)\"(?:x-forwarded-for|x-real-ip|cf-connecting-ip)\2\"\s*:\s*)\[(?!\s*\\?\"\[REDACTED)[^\]]*\]",
        lambda m: f"{m.group(1)}[{m.group(2)}\"[REDACTED_IP]{m.group(2)}\"]",
        text,
    )
    text = re.sub(r"(?i)((\\?)\"(?:x-forwarded-for|x-real-ip|cf-connecting-ip)\2\"\s*:\s*)(\2\")(?!\[REDACTED)[^\"\\]+\3", r"\1\3[REDACTED_IP]\3", text)
    text = re.sub(r"(?i)\b((?:x-forwarded-for|x-real-ip|cf-connecting-ip)\s*:\s*)(?!\[REDACTED)[^\r\n\"}\]]+", r"\1[REDACTED_IP]", text)

# Exact runtime secret values (including comma-separated encryption keys)
secrets_to_mask = []
for env_name in (
    "PG_DB_PASSWORD",
    "REDIS_PASSWORD",
    "EMDASH_ENCRYPTION_KEY",
    "EMDASH_AUTH_SECRET",
    "EMDASH_PREVIEW_SECRET",
    "S3_SECRET_ACCESS_KEY",
    "BACKUP_S3_SECRET_ACCESS_KEY",
    "BACKUP_ENCRYPTION_PASSPHRASE",
):
    secret = os.environ.get(env_name, "")
    if secret and len(secret) >= 4:
        secrets_to_mask.append(secret)
        if env_name == "EMDASH_ENCRYPTION_KEY" and "," in secret:
            for part in secret.split(","):
                part = part.strip()
                if len(part) >= 4:
                    secrets_to_mask.append(part)

for secret in sorted(set(secrets_to_mask), key=len, reverse=True):
    text = text.replace(secret, "[REDACTED]")

sys.stdout.write(text)
'
}

create_site_rollback() {
	local rollback_dir
	mkdir -p "${TMP_DIR}"
	rollback_dir="$(mktemp -d "${TMP_DIR}/emdashctl-site-rollback.XXXXXX")"
	if [[ -d "${SITE_DIR}" ]]; then
		mkdir -p "${rollback_dir}/site"
		cp -a "${SITE_DIR}/." "${rollback_dir}/site/"
	fi
	if [[ -d "${SCRIPTS_DIR}" ]]; then
		mkdir -p "${rollback_dir}/scripts"
		cp -a "${SCRIPTS_DIR}/." "${rollback_dir}/scripts/"
	fi
	if [[ -d "${ROOT_DIR}/lib" ]]; then
		mkdir -p "${rollback_dir}/lib"
		cp -a "${ROOT_DIR}/lib/." "${rollback_dir}/lib/"
	fi
	if [[ -f "${APP_ENV_FILE}" ]]; then
		mkdir -p "${rollback_dir}/app-env"
		cp -a "${APP_ENV_FILE}" "${rollback_dir}/app-env/content"
	else
		mkdir -p "${rollback_dir}/app-env"
		: >"${rollback_dir}/app-env/missing"
	fi
	if [[ -f "${APP_SYSTEMD_UNIT}" ]]; then
		mkdir -p "${rollback_dir}/systemd-unit"
		cp -a "${APP_SYSTEMD_UNIT}" "${rollback_dir}/systemd-unit/content"
	else
		mkdir -p "${rollback_dir}/systemd-unit"
		: >"${rollback_dir}/systemd-unit/missing"
