scan_db_encrypted_kid_refs() {
	if [[ "${DB_DRIVER}" == "sqlite" ]]; then
		if [[ ! -f "${SQLITE_PATH}" ]]; then
			printf '{"supported":true,"checked":true,"counts":{},"tables":{}}\n'
			return 0
		fi
		SQLITE_PATH="${SQLITE_PATH}" python3 - <<'PY'
import json, os, sqlite3

db_path = os.environ["SQLITE_PATH"]
counts = {}
tables = {}

def walk(val, table_name):
    if isinstance(val, dict):
        if val.get("$emdash") == "encrypted" and isinstance(val.get("kid"), str) and val.get("kid"):
            kid = val["kid"]
            counts[kid] = counts.get(kid, 0) + 1
            tset = tables.setdefault(kid, [])
            if table_name not in tset:
                tset.append(table_name)
        for v in val.values():
            walk(v, table_name)
    elif isinstance(val, list):
        for item in val:
            walk(item, table_name)
    elif isinstance(val, str):
        if '"$emdash"' in val and '"encrypted"' in val:
            try:
                parsed = json.loads(val)
                walk(parsed, table_name)
            except Exception:
                pass

try:
    conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    cur = conn.cursor()
    cur.execute("SELECT name FROM sqlite_master WHERE type='table'")
    all_tables = [r[0] for r in cur.fetchall()]
    preferred = ["_emdash_options", "_emdash_plugins", "_emdash_plugin_storage"]
    scan_tables = [t for t in all_tables if t in preferred or "emdash" in t.lower()]
    for tbl in scan_tables:
        q_tbl = '"' + tbl.replace('"', '""') + '"'
        try:
            for row in cur.execute(f"SELECT * FROM {q_tbl}"):
                for col in row:
                    if isinstance(col, str) and '"$emdash"' in col:
                        walk(col, tbl)
        except Exception:
            continue
    conn.close()
    print(json.dumps({"supported": True, "checked": True, "counts": counts, "tables": tables}))
except Exception as exc:
    print(json.dumps({"supported": True, "checked": False, "error": str(exc), "counts": {}, "tables": {}}))
PY
		return 0
	fi

	# PostgreSQL scan via psql + Python JSON walker
	if ! command -v psql >/dev/null 2>&1; then
		printf '{"supported":true,"checked":false,"error":"psql not found","counts":{},"tables":{}}\n'
		return 0
	fi
	local pg_tables=""
	if ! pg_tables="$(PGPASSWORD="${PG_DB_PASSWORD:-}" psql -h "${POSTGRES_HOST:-127.0.0.1}" -p "${POSTGRES_PORT:-5432}" -U "${PG_DB_USER:-emdash}" -d "${PG_DB_NAME:-emdash}" -tAc "SELECT tablename FROM pg_tables WHERE schemaname = 'public' AND (tablename IN ('_emdash_options','_emdash_plugins','_emdash_plugin_storage') OR tablename ILIKE '%emdash%');" 2>/dev/null)"; then
		printf '{"supported":true,"checked":false,"error":"postgresql query failed","counts":{},"tables":{}}\n'
		return 0
	fi
	local scan_tmp=""
	scan_tmp="$(mktemp)"
	PG_SCAN_TMP="${scan_tmp}"
	trap 'rm -f "${PG_SCAN_TMP:-}"' RETURN
	local tbl=""
	while IFS= read -r tbl; do
		[[ -n "${tbl}" ]] || continue
		[[ "${tbl}" =~ ^[A-Za-z0-9_]+$ ]] || continue
		# Match %$emdash% without quotes so both JSON/JSONB columns and JSON-in-TEXT columns
		# (where row_to_json escapes quotes as \") are returned for exact Python envelope parsing.
		PGPASSWORD="${PG_DB_PASSWORD:-}" psql -h "${POSTGRES_HOST:-127.0.0.1}" -p "${POSTGRES_PORT:-5432}" -U "${PG_DB_USER:-emdash}" -d "${PG_DB_NAME:-emdash}" \
			-tAc "SELECT '${tbl}' || E'\t' || row_to_json(t)::text FROM \"${tbl}\" t WHERE row_to_json(t)::text LIKE '%\$emdash%';" >>"${scan_tmp}" 2>/dev/null || true
	done <<<"${pg_tables}"

	SCAN_FILE="${scan_tmp}" python3 - <<'PY'
import json, os
from pathlib import Path

counts = {}
tables = {}

def walk(val, table_name):
    if isinstance(val, dict):
        if val.get("$emdash") == "encrypted" and isinstance(val.get("kid"), str) and val.get("kid"):
            kid = val["kid"]
            counts[kid] = counts.get(kid, 0) + 1
            tset = tables.setdefault(kid, [])
            if table_name not in tset:
                tset.append(table_name)
        for v in val.values():
            walk(v, table_name)
    elif isinstance(val, list):
        for item in val:
            walk(item, table_name)
    elif isinstance(val, str):
        if '"$emdash"' in val and '"encrypted"' in val:
            try:
                parsed = json.loads(val)
                walk(parsed, table_name)
            except Exception:
                pass

for line in Path(os.environ["SCAN_FILE"]).read_text(errors="replace").splitlines():
    if "\t" not in line:
        continue
    tbl, payload = line.split("\t", 1)
    try:
        obj = json.loads(payload)
        walk(obj, tbl)
    except Exception:
        pass

print(json.dumps({"supported": True, "checked": True, "counts": counts, "tables": tables}))
PY
	rm -f "${scan_tmp}"
	PG_SCAN_TMP=""
	trap - RETURN
}

