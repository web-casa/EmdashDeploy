logs_command() {
	local target="${1:-app}"
	local follow="${2:-0}"
	local service
	service="$(service_name_for "${target}")" || fail "Unknown logs target: ${target}"
	if [[ "${follow}" == "1" ]]; then
		exec journalctl -u "${service}" -f
	fi
	exec journalctl -u "${service}" -n 200 --no-pager
}

restart_command() {
	local target="${1:-app}"
	if [[ "${target}" == "all" ]]; then
		systemctl restart "${APP_SYSTEMD_SERVICE}"
		[[ "${SESSION_DRIVER}" == "redis" ]] && systemctl restart "${REDIS_SERVICE}"
		[[ "${DB_DRIVER}" == "postgres" ]] && systemctl restart "${POSTGRES_SERVICE}"
		[[ "${USE_CADDY}" == "1" ]] && systemctl restart caddy
		return
	fi
	systemctl restart "$(service_name_for "${target}")"
}

prune_local_backups() {
	local keep="${BACKUP_KEEP_LOCAL:-7}"
	mapfile -t backups < <(ls -1t "${BACKUP_DIR}"/emdash-backup-*.tar.gz* 2>/dev/null || true)
	if (( ${#backups[@]} <= keep )); then
		return
	fi
	for old in "${backups[@]:keep}"; do
		rm -f "${old}"
	done
}

create_backup_archive() {
	local full_mode="${1:-0}"
	local encrypt_mode="${2:-0}"
	local ts archive tmpdir plain_archive avail_mb emdash_ver key_kid=""

	if [[ -n "${BACKUP_ENCRYPTION_PASSPHRASE:-}" ]]; then
		encrypt_mode="1"
	fi
	if [[ "${encrypt_mode}" == "1" && -z "${BACKUP_ENCRYPTION_PASSPHRASE:-}" ]]; then
		fail "Backup encryption requested (--encrypt), but BACKUP_ENCRYPTION_PASSPHRASE is not set."
	fi

	mkdir -p "${BACKUP_DIR}"
	avail_mb="$(df -Pm "${BACKUP_DIR}" 2>/dev/null | awk 'NR==2 {print $4}' || echo 0)"
	if [[ "${avail_mb}" =~ ^[0-9]+$ ]] && (( avail_mb < 128 )); then
		fail "Insufficient disk space in ${BACKUP_DIR}: only ${avail_mb} MiB available."
	fi

	umask 0077
	ts="$(date +%Y%m%d-%H%M%S)"
	plain_archive="${BACKUP_DIR}/emdash-backup-${ts}.tar.gz"
	archive="${plain_archive}"
	tmpdir="$(mktemp -d)"
	BACKUP_TMP_DIR="${tmpdir}"
	trap 'rm -rf "${BACKUP_TMP_DIR:-}"' RETURN
	mkdir -p "${tmpdir}/meta" "${tmpdir}/data"

	cp -a "${INSTALL_YAML}" "${APP_ENV_FILE}" "${tmpdir}/meta/" 2>/dev/null || true

	if [[ "${DB_DRIVER}" == "sqlite" ]]; then
		mkdir -p "${tmpdir}/data/sqlite"
		if [[ -f "${SQLITE_PATH}" ]]; then
			python3 - "${SQLITE_PATH}" "${tmpdir}/data/sqlite/data.db" <<'PY'
import sqlite3, sys
src, dst = sys.argv[1], sys.argv[2]
src_db = sqlite3.connect(src)
dst_db = sqlite3.connect(dst)
src_db.backup(dst_db)
integrity = dst_db.execute("PRAGMA integrity_check;").fetchone()
dst_db.close()
src_db.close()
if not integrity or integrity[0] != "ok":
    raise SystemExit(f"SQLite backup integrity_check failed: {integrity}")
PY
		fi
	else
		PGPASSWORD="${PG_DB_PASSWORD}" pg_dump -Fc -h "${POSTGRES_HOST:-127.0.0.1}" -p "${POSTGRES_PORT:-5432}" -U "${PG_DB_USER}" -d "${PG_DB_NAME}" -f "${tmpdir}/data/postgres.dump"
		pg_restore --list "${tmpdir}/data/postgres.dump" >/dev/null || fail "PostgreSQL backup verification (pg_restore --list) failed."
	fi

	if [[ "${STORAGE_DRIVER}" == "local" && -d "${UPLOADS_DIR}" ]]; then
		cp -a "${UPLOADS_DIR}" "${tmpdir}/data/uploads"
	fi
	if [[ "${SESSION_DRIVER}" == "file" && -d "${SESSIONS_DIR}" ]]; then
		cp -a "${SESSIONS_DIR}" "${tmpdir}/data/sessions"
	fi

	# Always include lightweight site source tree (excluding node_modules/dist/.astro/.git)
	if [[ -d "${SITE_DIR}" ]]; then
		mkdir -p "${tmpdir}/site"
		tar -C "${SITE_DIR}" \
			--exclude='./node_modules' \
			--exclude='./dist' \
			--exclude='./.astro' \
			--exclude='./.git' \
			--exclude='./.emdash' \
			-cf - . | tar -C "${tmpdir}/site" -xf -
	fi

	if [[ "${full_mode}" == "1" ]]; then
		if [[ -d "${SCRIPTS_DIR}" ]]; then
			cp -a "${SCRIPTS_DIR}" "${tmpdir}/scripts"
		fi
		[[ -f "${CADDYFILE_PATH}" ]] && cp -a "${CADDYFILE_PATH}" "${tmpdir}/meta/Caddyfile"
		[[ -f "${APP_SYSTEMD_UNIT}" ]] && cp -a "${APP_SYSTEMD_UNIT}" "${tmpdir}/meta/emdash-app.service"
	fi

	emdash_ver="$(python3 - "${SITE_DIR}/package.json" <<'PY' 2>/dev/null || echo unknown
import json, sys
from pathlib import Path
p = Path(sys.argv[1])
if p.exists():
    pkg = json.loads(p.read_text())
    print(pkg.get("dependencies", {}).get("emdash", "unknown"))
else:
    print("unknown")
PY
)"
	if [[ -n "${EMDASH_ENCRYPTION_KEY:-}" ]] && declare -F emdash_encryption_key_fingerprint >/dev/null 2>&1; then
		key_kid="$(emdash_encryption_key_fingerprint "${EMDASH_ENCRYPTION_KEY}" 2>/dev/null || true)"
	fi

	BACKUP_DIR_TMP="${tmpdir}" \
	BACKUP_TS="${ts}" \
	BACKUP_MODE="$([[ "${full_mode}" == "1" ]] && echo full || echo standard)" \
	EMDASH_VER="${emdash_ver}" \
	KEY_KID="${key_kid}" \
	DB_DRIVER="${DB_DRIVER}" \
	SESSION_DRIVER="${SESSION_DRIVER}" \
	STORAGE_DRIVER="${STORAGE_DRIVER}" \
	TEMPLATE="${TEMPLATE:-blog}" \
	python3 - <<'PY'
import hashlib, json, os
from pathlib import Path

root = Path(os.environ["BACKUP_DIR_TMP"])
checksums = {}
for p in sorted(root.rglob("*")):
    if p.is_file():
        rel = p.relative_to(root).as_posix()
        if rel == "meta/manifest.json":
            continue
        h = hashlib.sha256()
        with p.open("rb") as fh:
            for chunk in iter(lambda: fh.read(65536), b""):
                h.update(chunk)
        checksums[rel] = h.hexdigest()

manifest = {
    "schema_version": 1,
    "created_at": os.environ["BACKUP_TS"],
    "backup_mode": os.environ["BACKUP_MODE"],
    "template": os.environ["TEMPLATE"],
    "emdash_dependency": os.environ["EMDASH_VER"],
    "db_driver": os.environ["DB_DRIVER"],
    "session_driver": os.environ["SESSION_DRIVER"],
    "storage_driver": os.environ["STORAGE_DRIVER"],
    "encryption_key_kid": os.environ["KEY_KID"],
    "contains_site_source": (root / "site").is_dir(),
    "files": checksums,
}
(root / "meta" / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
PY

	tar -C "${tmpdir}" -czf "${plain_archive}" .
	chmod 0600 "${plain_archive}"
	tar -tzf "${plain_archive}" >/dev/null || fail "Backup archive verification (tar -tzf) failed."

	if [[ "${encrypt_mode}" == "1" ]]; then
		archive="${plain_archive}.enc"
		BACKUP_ENCRYPTION_PASSPHRASE="${BACKUP_ENCRYPTION_PASSPHRASE}" openssl enc -aes-256-cbc -pbkdf2 -iter 100000 -salt \
			-pass env:BACKUP_ENCRYPTION_PASSPHRASE \
			-in "${plain_archive}" -out "${archive}"
		chmod 0600 "${archive}"
		rm -f "${plain_archive}"
	fi

	rm -rf "${tmpdir}"
	BACKUP_TMP_DIR=""
	trap - RETURN

	if [[ "${BACKUP_TARGET_TYPE}" == "s3" ]]; then
		if [[ "${encrypt_mode}" != "1" ]]; then
			warn "Uploading unencrypted backup containing emdash.env to S3. Set BACKUP_ENCRYPTION_PASSPHRASE to encrypt backups."
		fi
		python3 - "${BACKUP_S3_ENDPOINT}" "${BACKUP_S3_REGION}" "${BACKUP_S3_BUCKET}" "${BACKUP_S3_ACCESS_KEY_ID}" "${BACKUP_S3_SECRET_ACCESS_KEY}" "${BACKUP_S3_PREFIX%/}/$(basename "${archive}")" "${archive}" <<'PY'
import sys
import boto3
from botocore.config import Config

endpoint, region, bucket, access, secret, key, archive_path = sys.argv[1:]
client = boto3.client(
    "s3",
    endpoint_url=endpoint,
    aws_access_key_id=access,
    aws_secret_access_key=secret,
    region_name=region,
    config=Config(signature_version="s3v4"),
)
with open(archive_path, "rb") as fh:
    client.upload_fileobj(fh, bucket, key)
PY
	fi

	prune_local_backups
	printf '%s\n' "${archive}"
}

backup_command() {
	local full_mode="0" encrypt_mode="0" archive=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--full) full_mode="1" ;;
		--encrypt) encrypt_mode="1" ;;
		*) fail "Unknown backup option: $1" ;;
		esac
		shift
	done
	acquire_op_lock
	archive="$(create_backup_archive "${full_mode}" "${encrypt_mode}")"
	log "$(ct backup_complete): ${archive}"
}

restore_command() {
	local archive="" with_site="0" with_secrets="0" assume_yes="0"
	local tmpdir decrypted_tar ts tmp_db old_db manifest_db_driver=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--with-site) with_site="1" ;;
		--with-secrets) with_secrets="1" ;;
		--yes | -y) assume_yes="1" ;;
		-*) fail "Unknown restore option: $1" ;;
		*)
			[[ -z "${archive}" ]] || fail "Unexpected extra argument: $1"
			archive="$1"
			;;
		esac
		shift
	done

	[[ -n "${archive}" && -f "${archive}" ]] || fail "Backup file not found: ${archive:-<empty>}"
	acquire_op_lock

	umask 0077
	tmpdir="$(mktemp -d)"
	BACKUP_TMP_DIR="${tmpdir}"
	trap 'rm -rf "${BACKUP_TMP_DIR:-}"' RETURN

	if [[ "${archive}" == *.enc ]]; then
		[[ -n "${BACKUP_ENCRYPTION_PASSPHRASE:-}" ]] || fail "Encrypted backup requires BACKUP_ENCRYPTION_PASSPHRASE."
		decrypted_tar="${tmpdir}/decrypted.tar.gz"
		BACKUP_ENCRYPTION_PASSPHRASE="${BACKUP_ENCRYPTION_PASSPHRASE}" openssl enc -d -aes-256-cbc -pbkdf2 -iter 100000 \
			-pass env:BACKUP_ENCRYPTION_PASSPHRASE \
			-in "${archive}" -out "${decrypted_tar}" \
			|| fail "Failed to decrypt backup archive."
		tar -C "${tmpdir}" -xzf "${decrypted_tar}"
		rm -f "${decrypted_tar}"
	else
		tar -C "${tmpdir}" -xzf "${archive}"
	fi

	# Validate manifest driver compatibility when present
	if [[ -f "${tmpdir}/meta/manifest.json" ]]; then
		manifest_db_driver="$(python3 - "${tmpdir}/meta/manifest.json" <<'PY' 2>/dev/null || true
import json, sys
print(json.load(open(sys.argv[1])).get("db_driver", ""))
PY
)"
		if [[ -n "${manifest_db_driver}" && "${manifest_db_driver}" != "${DB_DRIVER}" ]]; then
			fail "Backup DB driver (${manifest_db_driver}) does not match host DB driver (${DB_DRIVER})."
		fi
	fi

	if [[ "${DB_DRIVER}" == "postgres" ]]; then
		chmod 0755 "${tmpdir}" "${tmpdir}/data" 2>/dev/null || true
		chmod 0644 "${tmpdir}/data/postgres.dump" "${tmpdir}/data/postgres.sql" 2>/dev/null || true
	fi

	systemctl stop "${APP_SYSTEMD_SERVICE}" || true

	if [[ "${DB_DRIVER}" == "sqlite" ]]; then
		[[ -f "${tmpdir}/data/sqlite/data.db" ]] || fail "SQLite backup file not found in archive"
		mkdir -p "${SQLITE_DIR}"
		rm -f "${SQLITE_PATH}" "${SQLITE_PATH}-wal" "${SQLITE_PATH}-shm"
		install -m 0640 -o "${APP_RUN_USER}" -g "${APP_RUN_GROUP}" "${tmpdir}/data/sqlite/data.db" "${SQLITE_PATH}"
	else
		ts="$(date +%s)"
		tmp_db="${PG_DB_NAME}_restore_${ts}"
		old_db="${PG_DB_NAME}_pre_restore_${ts}"
		if [[ -f "${tmpdir}/data/postgres.dump" ]]; then
			pg_restore --list "${tmpdir}/data/postgres.dump" >/dev/null || fail "Invalid PostgreSQL custom dump archive"
			runuser -u postgres -- createdb -O "${PG_DB_USER}" "${tmp_db}"
			runuser -u postgres -- pg_restore --no-owner --role="${PG_DB_USER}" -d "${tmp_db}" "${tmpdir}/data/postgres.dump"
		elif [[ -f "${tmpdir}/data/postgres.sql" ]]; then
			runuser -u postgres -- createdb -O "${PG_DB_USER}" "${tmp_db}"
			runuser -u postgres -- psql -d "${tmp_db}" -f "${tmpdir}/data/postgres.sql" >/dev/null
		else
			fail "PostgreSQL dump not found in archive"
		fi
		runuser -u postgres -- psql postgres <<EOF
SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname IN ('${PG_DB_NAME}', '${tmp_db}');
ALTER DATABASE ${PG_DB_NAME} RENAME TO ${old_db};
ALTER DATABASE ${tmp_db} RENAME TO ${PG_DB_NAME};
EOF
	fi

	if [[ -d "${tmpdir}/data/uploads" ]]; then
		mkdir -p "${UPLOADS_DIR}"
		rm -rf "${UPLOADS_DIR:?}/"*
		cp -a "${tmpdir}/data/uploads/." "${UPLOADS_DIR}/"
		chown -R "${APP_RUN_USER}:${APP_RUN_GROUP}" "${UPLOADS_DIR}" 2>/dev/null || true
	fi
	if [[ -d "${tmpdir}/data/sessions" ]]; then
		mkdir -p "${SESSIONS_DIR}"
		rm -rf "${SESSIONS_DIR:?}/"*
		cp -a "${tmpdir}/data/sessions/." "${SESSIONS_DIR}/"
		chown -R "${APP_RUN_USER}:${APP_RUN_GROUP}" "${SESSIONS_DIR}" 2>/dev/null || true
	fi

	# Merge ONLY portable cryptographic secrets (never overwrite host domain/ports/db passwords)
	if [[ "${with_secrets}" == "1" && -f "${tmpdir}/meta/emdash.env" ]]; then
		local src_enc src_auth src_prev cur_kid new_kid
		src_enc="$(set +u; set -a; . "${tmpdir}/meta/emdash.env" 2>/dev/null; set +a; printf '%s' "${EMDASH_ENCRYPTION_KEY:-}")"
		src_auth="$(set +u; set -a; . "${tmpdir}/meta/emdash.env" 2>/dev/null; set +a; printf '%s' "${EMDASH_AUTH_SECRET:-}")"
		src_prev="$(set +u; set -a; . "${tmpdir}/meta/emdash.env" 2>/dev/null; set +a; printf '%s' "${EMDASH_PREVIEW_SECRET:-}")"
		cur_kid="$(emdash_encryption_key_fingerprint "${EMDASH_ENCRYPTION_KEY:-}" 2>/dev/null || echo none)"
		new_kid="$(emdash_encryption_key_fingerprint "${src_enc}" 2>/dev/null || echo none)"
		log "Secret merge diff: EMDASH_ENCRYPTION_KEY kid ${cur_kid} -> ${new_kid} (host domain/ports/DB credentials unchanged)"
		if [[ "${assume_yes}" != "1" && -t 0 ]]; then
			local ans=""
			read -r -p "Merge portable secrets from backup into ${APP_ENV_FILE}? [y/N]: " ans
			[[ "${ans,,}" == "y" || "${ans,,}" == "yes" ]] || fail "Restore aborted before secret merge."
		fi
		[[ -n "${src_enc}" ]] && update_env_value "EMDASH_ENCRYPTION_KEY" "${src_enc}" "${APP_ENV_FILE}"
		[[ -n "${src_auth}" ]] && update_env_value "EMDASH_AUTH_SECRET" "${src_auth}" "${APP_ENV_FILE}"
		[[ -n "${src_prev}" ]] && update_env_value "EMDASH_PREVIEW_SECRET" "${src_prev}" "${APP_ENV_FILE}"
	fi

	if [[ "${with_site}" == "1" ]]; then
		[[ -d "${tmpdir}/site" ]] || fail "Backup archive does not contain site source (--with-site)."
		rm -rf "${SITE_DIR}"
		mkdir -p "${SITE_DIR}"
		cp -a "${tmpdir}/site/." "${SITE_DIR}/"
		chown -R "${APP_RUN_USER}:${APP_RUN_GROUP}" "${SITE_DIR}" 2>/dev/null || true
		run_as_app_user "'${APP_BUILD_SCRIPT}'"
	fi

	rm -rf "${tmpdir}"
	BACKUP_TMP_DIR=""
	trap - RETURN

	systemctl start "${APP_SYSTEMD_SERVICE}"
	wait_http_ok "$(local_health_url)" 60 || fail "Application did not become healthy after restore"
	log "$(ct restore_complete)"
}

plan_emdash_dependency_upgrade() {
	local target_version="${1:-latest}"
	SITE_DIR="${SITE_DIR}" TARGET_VERSION="${target_version}" NPM_CONFIG_REGISTRY="${NPM_CONFIG_REGISTRY:-}" python3 - <<'PY'
import json
import os
import urllib.request
from pathlib import Path

pkg_path = Path(os.environ["SITE_DIR"]) / "package.json"
if not pkg_path.is_file():
    raise SystemExit(f"package.json not found in {pkg_path}")

pkg = json.loads(pkg_path.read_text())
target = os.environ["TARGET_VERSION"]
registry = (os.environ.get("NPM_CONFIG_REGISTRY") or "https://registry.npmjs.org").rstrip("/")

def resolve_version(pkg_name: str, requested: str) -> str:
    if requested != "latest" and pkg_name == "emdash":
        return requested
    url = f"{registry}/{pkg_name.replace('/', '%2F')}/latest"
    req = urllib.request.Request(url, headers={"Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = json.loads(resp.read().decode("utf-8"))
        return data["version"]

changes = []
for section in ("dependencies", "devDependencies"):
    deps = pkg.get(section) or {}
    for name, current in sorted(deps.items()):
        if name == "emdash" or name.startswith("@emdash-cms/"):
            next_ver = resolve_version(name, target if name == "emdash" else "latest")
            next_spec = f"^{next_ver}"
            changes.append({
                "section": section,
                "name": name,
                "from": current,
                "to": next_spec,
                "changed": current != next_spec,
            })

print(json.dumps({"changes": changes}, indent=2))
PY
}

apply_emdash_dependency_upgrade() {
	local plan_json="$1"
	SITE_DIR="${SITE_DIR}" PLAN_JSON="${plan_json}" python3 - <<'PY'
import json
import os
from pathlib import Path

pkg_path = Path(os.environ["SITE_DIR"]) / "package.json"
pkg = json.loads(pkg_path.read_text())
plan = json.loads(os.environ["PLAN_JSON"])

for item in plan.get("changes", []):
    section = pkg.setdefault(item["section"], {})
    section[item["name"]] = item["to"]

pkg_path.write_text(json.dumps(pkg, indent=2) + "\n")
PY
}

run_upgrade_migration_gate() {
	local assume_yes="${1:-0}"
	local mig_json="" supported="" valid="" pending_count="0" unknown_count="0"

	mig_json="$(probe_emdash_migrations)"
	supported="$(printf '%s' "${mig_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("supported", False))' 2>/dev/null || echo False)"
	if [[ "${supported}" != "True" ]]; then
		warn "Current EmDash CLI does not expose 'emdash migrate'."
		if [[ "${assume_yes}" != "1" ]]; then
			warn "Pass --yes to continue upgrading legacy EmDash without explicit migration gate."
			return 1
		fi
		return 0
	fi

	valid="$(printf '%s' "${mig_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("valid", False))' 2>/dev/null || echo False)"
	if [[ "${valid}" != "True" ]]; then
		warn "Unable to parse JSON from 'emdash migrate --status --json'; refusing to apply migrations blindly."
		return 1
	fi

	unknown_count="$(printf '%s' "${mig_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("unknown_applied_count", 0))' 2>/dev/null || echo 0)"
	pending_count="$(printf '%s' "${mig_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("pending_count", 0))' 2>/dev/null || echo 0)"

	if (( unknown_count > 0 )); then
		warn "Database contains ${unknown_count} unknown applied migrations (DB newer than target code). Aborting."
		return 1
	fi

	if (( pending_count > 0 )); then
		log "Applying ${pending_count} pending database migrations explicitly..."
		UPGRADE_MIGRATION_ATTEMPTED="1"
		run_as_app_user "set -a; [[ -f '${APP_ENV_FILE}' ]] && . '${APP_ENV_FILE}'; set +a; cd '${SITE_DIR}' && COREPACK_ENABLE_DOWNLOAD_PROMPT=0 pnpm exec emdash migrate"
		return $?
	fi

	log "Database migrations are already up to date (0 pending)."
	return 0
}

upgrade_app_command() {
	local target_version="latest" dry_run="0" skip_backup="0" assume_yes="0"
	local plan_json="" rollback_dir="" pre_upgrade_backup=""
	UPGRADE_MIGRATION_ATTEMPTED="0"
	UPGRADE_ROLLBACK_DONE="0"

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--target=*) target_version="${1#--target=}" ;;
		--target)
			shift
			[[ $# -gt 0 ]] || fail "Missing value for --target"
			target_version="$1"
			;;
		--dry-run) dry_run="1" ;;
		--skip-backup) skip_backup="1" ;;
		--yes | -y) assume_yes="1" ;;
		*) fail "Unknown upgrade app option: $1" ;;
		esac
		shift
	done

	[[ -f "${SITE_DIR}/package.json" ]] || fail "Site package.json not found: ${SITE_DIR}/package.json"
	migrate_managed_script_paths_if_legacy

	plan_json="$(plan_emdash_dependency_upgrade "${target_version}")"
	log "EmDash dependency upgrade plan (preserving all user templates, pages, styles, and astro.config.mjs):"
	printf '%s\n' "${plan_json}" | python3 -c '
import json, sys
for item in json.load(sys.stdin).get("changes", []):
    marker = "*" if item["changed"] else "="
    name = item["name"]
    old_v = item["from"]
    new_v = item["to"]
    print(f"  [{marker}] {name}: {old_v} -> {new_v}")
'

	if [[ "${dry_run}" == "1" ]]; then
		local mig_preview
		mig_preview="$(probe_emdash_migrations)"
		log "Current migration status: ${mig_preview}"
		log "Dry-run complete. No files or database were modified."
		return 0
	fi

	acquire_op_lock

	if [[ "${skip_backup}" != "1" ]]; then
		log "Creating verified pre-upgrade backup..."
		pre_upgrade_backup="$(create_backup_archive 1 0)"
		log "Pre-upgrade backup created: ${pre_upgrade_backup}"
	else
		warn "Skipping pre-upgrade backup (--skip-backup)."
	fi

	rollback_dir="$(create_site_rollback)"

	rollback_upgrade_once() {
		if [[ "${UPGRADE_ROLLBACK_DONE}" == "1" ]]; then
			return 0
		fi
		UPGRADE_ROLLBACK_DONE="1"
		if [[ "${UPGRADE_MIGRATION_ATTEMPTED}" == "1" ]]; then
			systemctl stop "${APP_SYSTEMD_SERVICE}" || true
			warn "CRITICAL: Failure occurred AFTER forward-only database migrations started."
			warn "Database will NOT be silently overwritten to prevent data corruption."
			if [[ -n "${pre_upgrade_backup}" ]]; then
				warn "Restore both database and site explicitly with:"
				warn "  emdashctl restore '${pre_upgrade_backup}' --with-site"
			fi
			rm -rf "${rollback_dir}"
			return 0
		fi
		warn "Upgrade failed before database migration; restoring previous site, scripts, env, and systemd unit."
		restore_site_rollback "${rollback_dir}"
		rm -rf "${rollback_dir}"
		systemctl start "${APP_SYSTEMD_SERVICE}" || true
	}

	trap 'rc=$?; if [[ $rc -ne 0 ]]; then rollback_upgrade_once; fi' RETURN

	systemctl stop "${APP_SYSTEMD_SERVICE}" || true

	apply_emdash_dependency_upgrade "${plan_json}"
	chown "${APP_RUN_USER}:${APP_RUN_GROUP}" "${SITE_DIR}/package.json" 2>/dev/null || true

	if ! run_as_app_user "EMDASH_BUILD_ALLOW_LOCKFILE_UPDATE=1 '${APP_BUILD_SCRIPT}'"; then
		rollback_upgrade_once
		trap - RETURN
		fail "Application dependency install/build failed; previous state restored."
	fi

	if ! run_upgrade_migration_gate "${assume_yes}"; then
		rollback_upgrade_once
		trap - RETURN
		fail "Upgrade aborted at migration gate."
	fi

	systemctl start "${APP_SYSTEMD_SERVICE}"
	if ! wait_http_ok "$(local_health_url)" 60; then
		systemctl stop "${APP_SYSTEMD_SERVICE}" || true
		rollback_upgrade_once
		trap - RETURN
		fail "Application did not become healthy after upgrade."
	fi

	trap - RETURN
	rm -rf "${rollback_dir}"
	log "EmDash upgrade completed safely without overwriting user site code."
}

upgrade_command() {
	local target="$1"
	shift || true
	case "${target}" in
	app)
		upgrade_app_command "$@"
		;;
	caddy-config)
		[[ "${USE_CADDY}" == "1" ]] || fail "caddy is not enabled"
		caddy validate --config /etc/caddy/Caddyfile
		systemctl reload caddy
		;;
	*)
		fail "$(ct upgrade_supported)"
		;;
	esac
}

