prune_local_backups() {
	local keep="${BACKUP_KEEP_LOCAL:-7}"
	mapfile -t backups < <(ls -1t "${BACKUP_DIR}"/emdash-backup-*.tar.gz* 2>/dev/null || true)
	if (( ${#backups[@]} <= keep )); then
		return
	fi
	for old in "${backups[@]:keep}"; do
		rm -f "${old}"
	done
}

list_s3_backups_json() {
	[[ "${BACKUP_TARGET_TYPE}" == "s3" ]] || fail "S3 backup target is not configured (BACKUP_TARGET_TYPE=${BACKUP_TARGET_TYPE})."
	[[ -n "${BACKUP_S3_BUCKET:-}" && -n "${BACKUP_S3_ENDPOINT:-}" ]] || fail "S3 backup endpoint/bucket is not configured."
	BACKUP_S3_ENDPOINT="${BACKUP_S3_ENDPOINT}" \
	BACKUP_S3_REGION="${BACKUP_S3_REGION:-auto}" \
	BACKUP_S3_BUCKET="${BACKUP_S3_BUCKET}" \
	BACKUP_S3_ACCESS_KEY_ID="${BACKUP_S3_ACCESS_KEY_ID:-}" \
	BACKUP_S3_SECRET_ACCESS_KEY="${BACKUP_S3_SECRET_ACCESS_KEY:-}" \
	BACKUP_S3_PREFIX="${BACKUP_S3_PREFIX:-backups}" \
	python3 - <<'PY'
import json, os, re
import boto3
from botocore.config import Config

prefix = os.environ["BACKUP_S3_PREFIX"].strip("/")
search_prefix = f"{prefix}/" if prefix else ""
pat = re.compile(r"^emdash-backup-\d{8}-\d{6}\.tar\.gz(\.enc)?$")

client = boto3.client(
    "s3",
    endpoint_url=os.environ["BACKUP_S3_ENDPOINT"],
    aws_access_key_id=os.environ["BACKUP_S3_ACCESS_KEY_ID"],
    aws_secret_access_key=os.environ["BACKUP_S3_SECRET_ACCESS_KEY"],
    region_name=os.environ["BACKUP_S3_REGION"],
    config=Config(signature_version="s3v4"),
)

items = []
paginator = client.get_paginator("list_objects_v2")
for page in paginator.paginate(Bucket=os.environ["BACKUP_S3_BUCKET"], Prefix=search_prefix):
    for obj in page.get("Contents", []) or []:
        key = obj["Key"]
        name = key.rsplit("/", 1)[-1]
        if not pat.match(name):
            continue
        lm = obj.get("LastModified")
        items.append({
            "key": key,
            "name": name,
            "size": int(obj.get("Size", 0)),
            "last_modified": lm.isoformat() if hasattr(lm, "isoformat") else str(lm or ""),
        })

items.sort(key=lambda x: (x["last_modified"], x["name"]), reverse=True)
print(json.dumps(items, indent=2))
PY
}

prune_s3_backups() {
	local keep="${BACKUP_KEEP_S3:-14}"
	[[ "${BACKUP_TARGET_TYPE}" == "s3" ]] || return 0
	[[ "${keep}" =~ ^[0-9]+$ ]] || return 0
	(( keep > 0 )) || return 0

	BACKUP_S3_ENDPOINT="${BACKUP_S3_ENDPOINT}" \
	BACKUP_S3_REGION="${BACKUP_S3_REGION:-auto}" \
	BACKUP_S3_BUCKET="${BACKUP_S3_BUCKET}" \
	BACKUP_S3_ACCESS_KEY_ID="${BACKUP_S3_ACCESS_KEY_ID:-}" \
	BACKUP_S3_SECRET_ACCESS_KEY="${BACKUP_S3_SECRET_ACCESS_KEY:-}" \
	BACKUP_S3_PREFIX="${BACKUP_S3_PREFIX:-backups}" \
	BACKUP_KEEP_S3="${keep}" \
	python3 - <<'PY'
import os, re, sys
import boto3
from botocore.config import Config

keep = int(os.environ["BACKUP_KEEP_S3"])
prefix = os.environ["BACKUP_S3_PREFIX"].strip("/")
search_prefix = f"{prefix}/" if prefix else ""
pat = re.compile(r"^emdash-backup-\d{8}-\d{6}\.tar\.gz(\.enc)?$")

client = boto3.client(
    "s3",
    endpoint_url=os.environ["BACKUP_S3_ENDPOINT"],
    aws_access_key_id=os.environ["BACKUP_S3_ACCESS_KEY_ID"],
    aws_secret_access_key=os.environ["BACKUP_S3_SECRET_ACCESS_KEY"],
    region_name=os.environ["BACKUP_S3_REGION"],
    config=Config(signature_version="s3v4"),
)

items = []
paginator = client.get_paginator("list_objects_v2")
for page in paginator.paginate(Bucket=os.environ["BACKUP_S3_BUCKET"], Prefix=search_prefix):
    for obj in page.get("Contents", []) or []:
        key = obj["Key"]
        name = key.rsplit("/", 1)[-1]
        if pat.match(name):
            lm = obj.get("LastModified")
            items.append((lm.isoformat() if hasattr(lm, "isoformat") else "", name, key))

items.sort(reverse=True)
for _, _, old_key in items[keep:]:
    client.delete_object(Bucket=os.environ["BACKUP_S3_BUCKET"], Key=old_key)
    print(f"[INFO] Pruned old S3 backup: {old_key}", file=sys.stderr)
PY
}

