#!/usr/bin/env bash
set -Eeuo pipefail

IFS=$'\n\t'
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0

ENV_FILE="${EMDASH_INSTALL_ENV_FILE:-/etc/emdash/emdash.env}"
EMDASH_INSTALL_LANG="${EMDASH_INSTALL_LANG:-en}"
EMDASHCTL_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

normalize_ctl_lang() {
	local input="${1:-en}"
	input="${input//_/-}"
	case "${input,,}" in
	en | english) printf 'en\n' ;;
	ja | jp | japanese) printf 'ja\n' ;;
	ko | korean) printf 'ko\n' ;;
	es | spanish | espanol | español) printf 'es\n' ;;
	de | german | deutsch) printf 'de\n' ;;
	fr | french | francais | français) printf 'fr\n' ;;
	zh-cn | zh-hans | zh-sg | zh) printf 'zh-CN\n' ;;
	zh-tw | zh-hant | zh-hk) printf 'zh-TW\n' ;;
	pt | pt-br | pt-pt | portuguese | portugues | português) printf 'pt\n' ;;
	*) printf 'en\n' ;;
	esac
}

ct() {
	local key="$1"
	local lang="${EMDASH_INSTALL_LANG:-en}"
	case "${key}" in
	usage_title) case "${lang}" in en) printf 'Usage:' ;; ja) printf '使い方:' ;; ko) printf '사용법:' ;; es) printf 'Uso:' ;; de) printf 'Verwendung:' ;; fr) printf 'Utilisation :' ;; zh-CN) printf '用法:' ;; zh-TW) printf '用法:' ;; pt) printf 'Uso:' ;; esac ;;
	missing_env) case "${lang}" in en) printf 'Missing environment file' ;; ja) printf '環境ファイルが見つかりません' ;; ko) printf '환경 파일이 없습니다' ;; es) printf 'Falta el archivo de entorno' ;; de) printf 'Umgebungsdatei fehlt' ;; fr) printf 'Fichier d’environnement manquant' ;; zh-CN) printf '缺少环境文件' ;; zh-TW) printf '缺少環境檔' ;; pt) printf 'Arquivo de ambiente ausente' ;; esac ;;
	unknown_command) case "${lang}" in en) printf 'Unknown command' ;; ja) printf '不明なコマンド' ;; ko) printf '알 수 없는 명령' ;; es) printf 'Comando desconocido' ;; de) printf 'Unbekannter Befehl' ;; fr) printf 'Commande inconnue' ;; zh-CN) printf '未知命令' ;; zh-TW) printf '未知命令' ;; pt) printf 'Comando desconhecido' ;; esac ;;
	backup_complete) case "${lang}" in en) printf 'Backup complete' ;; ja) printf 'バックアップ完了' ;; ko) printf '백업 완료' ;; es) printf 'Copia completada' ;; de) printf 'Backup abgeschlossen' ;; fr) printf 'Sauvegarde terminée' ;; zh-CN) printf '备份完成' ;; zh-TW) printf '備份完成' ;; pt) printf 'Backup concluído' ;; esac ;;
	restore_complete) case "${lang}" in en) printf 'Restore complete' ;; ja) printf '復元完了' ;; ko) printf '복원 완료' ;; es) printf 'Restauración completa' ;; de) printf 'Wiederherstellung abgeschlossen' ;; fr) printf 'Restauration terminée' ;; zh-CN) printf '恢复完成' ;; zh-TW) printf '還原完成' ;; pt) printf 'Restauração concluída' ;; esac ;;
	reset_only_postgres) case "${lang}" in en) printf 'reset-db-password is only supported for PostgreSQL' ;; ja) printf 'reset-db-password は PostgreSQL のみ対応です' ;; ko) printf 'reset-db-password는 PostgreSQL만 지원합니다' ;; es) printf 'reset-db-password solo es compatible con PostgreSQL' ;; de) printf 'reset-db-password wird nur für PostgreSQL unterstützt' ;; fr) printf 'reset-db-password est pris en charge uniquement pour PostgreSQL' ;; zh-CN) printf '当前仅 PostgreSQL 支持 reset-db-password' ;; zh-TW) printf '目前僅 PostgreSQL 支援 reset-db-password' ;; pt) printf 'reset-db-password só é compatível com PostgreSQL' ;; esac ;;
	upgrade_supported) case "${lang}" in en) printf 'Supported upgrade targets: app | caddy-config' ;; ja) printf '対応する upgrade 対象: app | caddy-config' ;; ko) printf '지원되는 upgrade 대상: app | caddy-config' ;; es) printf 'Objetivos compatibles: app | caddy-config' ;; de) printf 'Unterstützte Upgrade-Ziele: app | caddy-config' ;; fr) printf 'Cibles prises en charge : app | caddy-config' ;; zh-CN) printf '支持的 upgrade 目标: app | caddy-config' ;; zh-TW) printf '支援的 upgrade 目標: app | caddy-config' ;; pt) printf 'Alvos suportados: app | caddy-config' ;; esac ;;
	runtime_label) case "${lang}" in en) printf 'Runtime' ;; ja) printf '実行方式' ;; ko) printf '런타임' ;; es) printf 'Modo' ;; de) printf 'Laufzeit' ;; fr) printf 'Runtime' ;; zh-CN) printf '运行方式' ;; zh-TW) printf '執行方式' ;; pt) printf 'Runtime' ;; esac ;;
	url_label) case "${lang}" in en) printf 'URL' ;; ja) printf 'URL' ;; ko) printf 'URL' ;; es) printf 'URL' ;; de) printf 'URL' ;; fr) printf 'URL' ;; zh-CN) printf 'URL' ;; zh-TW) printf 'URL' ;; pt) printf 'URL' ;; esac ;;
	app_running_label) case "${lang}" in en) printf 'App running' ;; ja) printf 'アプリ稼働' ;; ko) printf '앱 실행 상태' ;; es) printf 'App activa' ;; de) printf 'App läuft' ;; fr) printf 'App active' ;; zh-CN) printf '应用运行' ;; zh-TW) printf '應用執行中' ;; pt) printf 'App em execução' ;; esac ;;
	app_health_label) case "${lang}" in en) printf 'App health' ;; ja) printf 'アプリ状態' ;; ko) printf '앱 상태' ;; es) printf 'Salud de la app' ;; de) printf 'App-Status' ;; fr) printf 'Santé de l’app' ;; zh-CN) printf '应用健康' ;; zh-TW) printf '應用健康' ;; pt) printf 'Saúde da app' ;; esac ;;
	setup_status_label) case "${lang}" in en) printf 'Setup status' ;; ja) printf 'セットアップ状態' ;; ko) printf '설정 상태' ;; es) printf 'Estado de setup' ;; de) printf 'Setup-Status' ;; fr) printf 'État du setup' ;; zh-CN) printf 'Setup 状态' ;; zh-TW) printf 'Setup 狀態' ;; pt) printf 'Status do setup' ;; esac ;;
	caddy_label) case "${lang}" in en) printf 'Caddy' ;; ja) printf 'Caddy' ;; ko) printf 'Caddy' ;; es) printf 'Caddy' ;; de) printf 'Caddy' ;; fr) printf 'Caddy' ;; zh-CN) printf 'Caddy' ;; zh-TW) printf 'Caddy' ;; pt) printf 'Caddy' ;; esac ;;
	esac
}

log() { printf '[INFO] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*" >&2; }
fail() { printf '[ERROR] %s\n' "$*" >&2; exit 1; }

usage() {
	cat <<EOF
emdashctl

$(ct usage_title)
  emdashctl [--lang <code>] status [--json]
  emdashctl [--lang <code>] doctor [--deep] [--json]
  emdashctl [--lang <code>] smoke [--json]
  emdashctl [--lang <code>] logs [app|postgres|redis|caddy] [-f]
  emdashctl [--lang <code>] restart [app|postgres|redis|all|caddy]
  emdashctl [--lang <code>] backup [--full] [--encrypt]
  emdashctl [--lang <code>] restore <backup-file> [--with-site] [--with-secrets] [--yes]
  emdashctl [--lang <code>] upgrade app [--target <version|latest>] [--dry-run] [--skip-backup] [--yes]
  emdashctl [--lang <code>] upgrade caddy-config
  emdashctl [--lang <code>] template diff [--stat]
  emdashctl [--lang <code>] reset-db-password
EOF
}

parse_lang_args() {
	local remaining=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--lang=*)
			EMDASH_INSTALL_LANG="$(normalize_ctl_lang "${1#--lang=}")"
			;;
		--lang)
			shift
			[[ $# -gt 0 ]] || fail "Missing value for --lang"
			EMDASH_INSTALL_LANG="$(normalize_ctl_lang "$1")"
			;;
		*)
			remaining+=("$1")
			;;
		esac
		shift || true
	done
	printf '%s\n' "${remaining[@]}"
}

load_site_common() {
	local candidate=""
	for candidate in \
		"${ROOT_DIR:-}/lib/site-common.sh" \
		"${EMDASHCTL_SCRIPT_DIR}/lib/site-common.sh"; do
		if [[ -n "${candidate}" && -f "${candidate}" ]]; then
			# shellcheck disable=SC1090
			source "${candidate}"
			return 0
		fi
	done
	return 1
}

load_env() {
	[[ -f "${ENV_FILE}" ]] || fail "$(ct missing_env): ${ENV_FILE}"
	set -a
	# shellcheck disable=SC1090
	source "${ENV_FILE}"
	set +a
	ROOT_DIR="${ROOT_DIR:-/data/emdash}"
	APP_ENV_FILE="${APP_ENV_FILE:-${ENV_FILE}}"
	INSTALL_YAML="${INSTALL_YAML:-/etc/emdash/install.yml}"
	SITE_DIR="${SITE_DIR:-${ROOT_DIR}/app/site}"
	SCRIPTS_DIR="${SCRIPTS_DIR:-${ROOT_DIR}/scripts}"
	TMP_DIR="${TMP_DIR:-${ROOT_DIR}/tmp}"
	BACKUP_DIR="${BACKUP_DIR:-${ROOT_DIR}/backups}"
	UPLOADS_DIR="${UPLOADS_DIR:-${ROOT_DIR}/data/uploads}"
	SESSIONS_DIR="${SESSIONS_DIR:-${ROOT_DIR}/data/sessions}"
	SQLITE_DIR="${SQLITE_DIR:-${ROOT_DIR}/data/sqlite}"
	SQLITE_PATH="${SQLITE_PATH:-${SQLITE_DIR}/data.db}"
	APP_SYSTEMD_SERVICE="${APP_SYSTEMD_SERVICE:-emdash-app}"
	APP_SYSTEMD_UNIT="${APP_SYSTEMD_UNIT:-/etc/systemd/system/${APP_SYSTEMD_SERVICE}.service}"
	APP_BUILD_SCRIPT="${APP_BUILD_SCRIPT:-${SCRIPTS_DIR}/emdash-build.sh}"
	APP_START_SCRIPT="${APP_START_SCRIPT:-${SCRIPTS_DIR}/emdash-start.sh}"
	CADDYFILE_PATH="${CADDYFILE_PATH:-/etc/emdash/caddy/Caddyfile}"
	ENABLE_PLUGIN_SANDBOX="${ENABLE_PLUGIN_SANDBOX:-1}"
	BACKUP_ENABLED="${BACKUP_ENABLED:-1}"
	BACKUP_TARGET_TYPE="${BACKUP_TARGET_TYPE:-local}"
	USE_CADDY="${USE_CADDY:-0}"
	ENABLE_HTTPS="${ENABLE_HTTPS:-0}"
	DB_DRIVER="${DB_DRIVER:-sqlite}"
	SESSION_DRIVER="${SESSION_DRIVER:-file}"
	STORAGE_DRIVER="${STORAGE_DRIVER:-local}"
	APP_PORT="${APP_PORT:-3000}"
	APP_RUN_USER="${APP_RUN_USER:-emdash}"
	APP_RUN_GROUP="${APP_RUN_GROUP:-emdash}"
	load_site_common || true
}

acquire_op_lock() {
	local lock_file="/run/lock/emdashctl.lock"
	if [[ ! -d /run/lock || ! -w /run/lock ]]; then
		mkdir -p "${TMP_DIR}"
		lock_file="${TMP_DIR}/emdashctl.lock"
	fi
	exec 9>"${lock_file}"
	if ! flock -n 9; then
		fail "Another emdashctl operation is currently running (lock: ${lock_file})."
	fi
}

bool_active() {
	systemctl is-active --quiet "$1" 2>/dev/null
}

service_name_for() {
	case "${1:-app}" in
	app) printf '%s\n' "${APP_SYSTEMD_SERVICE}" ;;
	postgres) printf '%s\n' "${POSTGRES_SERVICE}" ;;
	redis) printf '%s\n' "${REDIS_SERVICE}" ;;
	caddy) printf 'caddy\n' ;;
	*) return 1 ;;
	esac
}

local_health_url() {
	printf 'http://127.0.0.1:%s/healthz\n' "${APP_PORT:-3000}"
}

local_setup_url() {
	printf 'http://127.0.0.1:%s/_emdash/api/setup/status\n' "${APP_PORT:-3000}"
}

wait_http_ok() {
	local url="$1" tries="${2:-60}" i
	for ((i=1; i<=tries; i++)); do
		if curl -fsS --max-time 5 "${url}" >/dev/null 2>&1; then
			return 0
		fi
		sleep 2
	done
	return 1
}

run_as_app_user() {
	local cmd="$1"
	if [[ "$(id -un)" == "${APP_RUN_USER}" ]]; then
		bash -lc "${cmd}"
		return
	fi
	runuser -u "${APP_RUN_USER}" -- bash -lc "${cmd}"
}

update_env_value() {
	local key="$1"
	local value="$2"
	local file="${3:-${APP_ENV_FILE}}"
	if declare -F update_env_file_value >/dev/null 2>&1; then
		update_env_file_value "${key}" "${value}" "${file}"
		return
	fi
	KEY="${key}" VALUE="${value}" TARGET_FILE="${file}" python3 <<'PY'
from pathlib import Path
import os

def quote(value: str) -> str:
    value = value.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$").replace("`", "\\`").replace("\n", "\\n")
    return f'"{value}"'

path = Path(os.environ["TARGET_FILE"])
key = os.environ["KEY"]
value = os.environ["VALUE"]
lines = []
updated = False
if path.exists():
    for raw in path.read_text().splitlines():
        if raw.startswith(f"{key}="):
            lines.append(f"{key}={quote(value)}")
            updated = True
        else:
            lines.append(raw)
if not updated:
    lines.append(f"{key}={quote(value)}")
path.write_text("\n".join(lines) + "\n")
PY
}

redact_sensitive_text() {
	PG_DB_PASSWORD="${PG_DB_PASSWORD:-}" \
	REDIS_PASSWORD="${REDIS_PASSWORD:-}" \
	EMDASH_ENCRYPTION_KEY="${EMDASH_ENCRYPTION_KEY:-}" \
	EMDASH_AUTH_SECRET="${EMDASH_AUTH_SECRET:-}" \
	EMDASH_PREVIEW_SECRET="${EMDASH_PREVIEW_SECRET:-}" \
	S3_SECRET_ACCESS_KEY="${S3_SECRET_ACCESS_KEY:-}" \
	BACKUP_S3_SECRET_ACCESS_KEY="${BACKUP_S3_SECRET_ACCESS_KEY:-}" \
	BACKUP_ENCRYPTION_PASSPHRASE="${BACKUP_ENCRYPTION_PASSPHRASE:-}" \
	python3 -c '
import os, re, sys
text = sys.stdin.read()
text = re.sub(r"emdash_enc_v1_[A-Za-z0-9_-]{43}", "emdash_enc_v1_[REDACTED]", text)
text = re.sub(r"(postgres|postgresql|redis|rediss)://([^:@/\s]*):([^@/\s]+)@", r"\1://\2:[REDACTED]@", text)
for env_name in (
    "PG_DB_PASSWORD",
    "REDIS_PASSWORD",
    "EMDASH_ENCRYPTION_KEY",
    "EMDASH_AUTH_SECRET",
    "EMDASH_PREVIEW_SECRET",
    "S3_SECRET_ACCESS_KEY",
    "BACKUP_S3_SECRET_ACCESS_KEY",
    "BACKUP_ENCRYPTION_PASSPHRASE",
):
    secret = os.environ.get(env_name, "")
    if secret and len(secret) >= 4:
        text = text.replace(secret, "[REDACTED]")
sys.stdout.write(text)
'
}

create_site_rollback() {
	local rollback_dir
	mkdir -p "${TMP_DIR}"
	rollback_dir="$(mktemp -d "${TMP_DIR}/emdashctl-site-rollback.XXXXXX")"
	if [[ -d "${SITE_DIR}" ]]; then
		mkdir -p "${rollback_dir}/site"
		cp -a "${SITE_DIR}/." "${rollback_dir}/site/"
	fi
	if [[ -d "${SCRIPTS_DIR}" ]]; then
		mkdir -p "${rollback_dir}/scripts"
		cp -a "${SCRIPTS_DIR}/." "${rollback_dir}/scripts/"
	fi
	if [[ -d "${ROOT_DIR}/lib" ]]; then
		mkdir -p "${rollback_dir}/lib"
		cp -a "${ROOT_DIR}/lib/." "${rollback_dir}/lib/"
	fi
	if [[ -f "${APP_ENV_FILE}" ]]; then
		mkdir -p "${rollback_dir}/app-env"
		cp -a "${APP_ENV_FILE}" "${rollback_dir}/app-env/content"
	else
		mkdir -p "${rollback_dir}/app-env"
		: >"${rollback_dir}/app-env/missing"
	fi
	if [[ -f "${APP_SYSTEMD_UNIT}" ]]; then
		mkdir -p "${rollback_dir}/systemd-unit"
		cp -a "${APP_SYSTEMD_UNIT}" "${rollback_dir}/systemd-unit/content"
	else
		mkdir -p "${rollback_dir}/systemd-unit"
		: >"${rollback_dir}/systemd-unit/missing"
	fi
	printf '%s\n' "${rollback_dir}"
}

restore_site_rollback() {
	local rollback_dir="$1"
	if [[ -d "${rollback_dir}/site" ]]; then
		rm -rf "${SITE_DIR}"
		mkdir -p "${SITE_DIR}"
		cp -a "${rollback_dir}/site/." "${SITE_DIR}/"
		chown -R "${APP_RUN_USER}:${APP_RUN_GROUP}" "${SITE_DIR}" 2>/dev/null || true
	fi
	if [[ -d "${rollback_dir}/scripts" ]]; then
		rm -rf "${SCRIPTS_DIR}"
		mkdir -p "${SCRIPTS_DIR}"
		cp -a "${rollback_dir}/scripts/." "${SCRIPTS_DIR}/"
		chown -R "${APP_RUN_USER}:${APP_RUN_GROUP}" "${SCRIPTS_DIR}" 2>/dev/null || true
	fi
	if [[ -d "${rollback_dir}/lib" ]]; then
		rm -rf "${ROOT_DIR}/lib"
		mkdir -p "${ROOT_DIR}/lib"
		cp -a "${rollback_dir}/lib/." "${ROOT_DIR}/lib/"
	fi
	if [[ -f "${rollback_dir}/app-env/content" ]]; then
		mkdir -p "$(dirname "${APP_ENV_FILE}")"
		cp -a "${rollback_dir}/app-env/content" "${APP_ENV_FILE}"
	elif [[ -f "${rollback_dir}/app-env/missing" ]]; then
		rm -f "${APP_ENV_FILE}"
	fi
	if [[ -f "${rollback_dir}/systemd-unit/content" ]]; then
		mkdir -p "$(dirname "${APP_SYSTEMD_UNIT}")"
		cp -a "${rollback_dir}/systemd-unit/content" "${APP_SYSTEMD_UNIT}"
	elif [[ -f "${rollback_dir}/systemd-unit/missing" ]]; then
		rm -f "${APP_SYSTEMD_UNIT}"
	fi
	systemctl daemon-reload >/dev/null 2>&1 || true
}

migrate_managed_script_paths_if_legacy() {
	local old_build_script="${APP_BUILD_SCRIPT:-}"
	local old_start_script="${APP_START_SCRIPT:-}"
	local new_build_script="${APP_BUILD_SCRIPT:-}"
	local new_start_script="${APP_START_SCRIPT:-}"
	local migrated="0"

	if [[ "${old_build_script}" != "${SITE_DIR}/"* && "${old_start_script}" != "${SITE_DIR}/"* ]]; then
		return 0
	fi

	mkdir -p "${SCRIPTS_DIR}"

	if [[ "${APP_BUILD_SCRIPT}" == "${SITE_DIR}/"* ]]; then
		new_build_script="${SCRIPTS_DIR}/$(basename "${APP_BUILD_SCRIPT}")"
		if [[ -f "${old_build_script}" && "${old_build_script}" != "${new_build_script}" ]]; then
			cp -a "${old_build_script}" "${new_build_script}"
		fi
		APP_BUILD_SCRIPT="${new_build_script}"
		update_env_value "SCRIPTS_DIR" "${SCRIPTS_DIR}" "${APP_ENV_FILE}"
		update_env_value "APP_BUILD_SCRIPT" "${APP_BUILD_SCRIPT}" "${APP_ENV_FILE}"
		migrated="1"
	fi

	if [[ "${APP_START_SCRIPT}" == "${SITE_DIR}/"* ]]; then
		new_start_script="${SCRIPTS_DIR}/$(basename "${APP_START_SCRIPT}")"
		if [[ -f "${old_start_script}" && "${old_start_script}" != "${new_start_script}" ]]; then
			cp -a "${old_start_script}" "${new_start_script}"
		fi
		APP_START_SCRIPT="${new_start_script}"
		update_env_value "SCRIPTS_DIR" "${SCRIPTS_DIR}" "${APP_ENV_FILE}"
		update_env_value "APP_START_SCRIPT" "${APP_START_SCRIPT}" "${APP_ENV_FILE}"
		migrated="1"
	fi

	if [[ "${migrated}" == "1" && "${old_start_script}" != "${APP_START_SCRIPT}" && -f "${APP_SYSTEMD_UNIT}" ]]; then
		OLD_START_SCRIPT="${old_start_script}" NEW_START_SCRIPT="${APP_START_SCRIPT}" TARGET_FILE="${APP_SYSTEMD_UNIT}" python3 <<'PY'
from pathlib import Path
import os

path = Path(os.environ["TARGET_FILE"])
old = os.environ["OLD_START_SCRIPT"]
new = os.environ["NEW_START_SCRIPT"]
text = path.read_text()
updated = text.replace(f"ExecStart=/usr/bin/bash {old}", f"ExecStart=/usr/bin/bash {new}")
if updated != text:
    path.write_text(updated)
PY
	fi

	if id "${APP_RUN_USER}" >/dev/null 2>&1; then
		chown -R "${APP_RUN_USER}:${APP_RUN_GROUP}" "${SCRIPTS_DIR}" 2>/dev/null || true
	fi
	if [[ "${migrated}" == "1" ]]; then
		systemctl daemon-reload >/dev/null 2>&1 || true
		log "迁移旧脚本路径到 ${SCRIPTS_DIR}"
	fi
}

postgres_alter_password() {
	local role="$1"
	local password="$2"
	local alter_sql
	alter_sql="$(python3 - "${role}" "${password}" <<'PY'
import sys

user = sys.argv[1].replace('"', '""')
password = sys.argv[2].replace("'", "''")
print(f'ALTER ROLE "{user}" WITH PASSWORD \'{password}\';')
PY
)"
	runuser -u postgres -- psql postgres -c "${alter_sql}" >/dev/null
}

ensure_template_source_checkout() {
	[[ -n "${TEMPLATE_SOURCE_DIR:-}" ]] || fail "TEMPLATE_SOURCE_DIR is not configured"
	[[ -n "${TEMPLATES_REPO:-}" ]] || fail "TEMPLATES_REPO is not configured"
	[[ -n "${TEMPLATES_REF:-}" ]] || fail "TEMPLATES_REF is not configured"
	if [[ -d "${TEMPLATE_SOURCE_DIR}/.git" ]]; then
		git -C "${TEMPLATE_SOURCE_DIR}" pull --ff-only
		return
	fi
	rm -rf "${TEMPLATE_SOURCE_DIR}"
	git clone --depth 1 --branch "${TEMPLATES_REF}" "${TEMPLATES_REPO}" "${TEMPLATE_SOURCE_DIR}"
}

render_site_astro_config() {
	load_site_common || true
	if declare -F render_site_astro_config_common >/dev/null 2>&1; then
		render_site_astro_config_common
		return
	fi
	local patch_script="${ROOT_DIR:-}/lib/astro-patch.py"
	if [[ ! -f "${patch_script}" ]]; then
		patch_script="${EMDASHCTL_SCRIPT_DIR}/lib/astro-patch.py"
	fi
	[[ -f "${patch_script}" ]] || fail "astro-patch.py not found"
	SITE_DIR="${SITE_DIR}" DB_DRIVER="${DB_DRIVER}" SESSION_DRIVER="${SESSION_DRIVER}" STORAGE_DRIVER="${STORAGE_DRIVER}" ENABLE_PLUGIN_SANDBOX="${ENABLE_PLUGIN_SANDBOX:-1}" \
		python3 "${patch_script}"
}

render_site_app_scripts() {
	load_site_common || true
	if declare -F render_site_app_scripts_common >/dev/null 2>&1; then
		render_site_app_scripts_common
		return
	fi
	fail "site-common.sh not found"
}

status_command() {
	local as_json="${1:-0}"
	local app_running="false" app_health="failed" setup_status="unreachable" caddy_state="unavailable"
	local sqlite_exists="false"
	local caddy_enabled="false"
	bool_active "${APP_SYSTEMD_SERVICE}" && app_running="true"
	if curl -fsS --max-time 5 "$(local_health_url)" >/dev/null 2>&1; then
		app_health="ok"
	fi
	setup_status="$(
		curl -fsS --max-time 5 "$(local_setup_url)" 2>/dev/null | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
    payload = data.get("data", {})
    if payload.get("needsSetup") is False:
        print("complete")
    else:
        print("needs setup (%s)" % payload.get("step", "unknown"))
except Exception:
    print("unreachable")
' || true
	)"
	if [[ "${USE_CADDY}" == "1" ]] && bool_active caddy; then
		caddy_state="active"
	elif [[ "${USE_CADDY}" == "1" ]]; then
		caddy_state="inactive"
	fi
	[[ -f "${SQLITE_PATH}" ]] && sqlite_exists="true"
	[[ "${USE_CADDY}" == "1" ]] && caddy_enabled="true"

	if [[ "${as_json}" == "1" ]]; then
		APP_RUNNING="${app_running}" \
		APP_HEALTH="${app_health}" \
		SETUP_STATUS="${setup_status}" \
		SQLITE_EXISTS="${sqlite_exists}" \
		CADDY_ENABLED="${caddy_enabled}" \
		CADDY_STATE="${caddy_state}" \
		python3 <<PY
import json
import os

def as_bool(name):
