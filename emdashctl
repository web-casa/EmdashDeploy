parse_migrate_status_json() {
	python3 -c '
import json, sys
raw = sys.stdin.read()
parsed = None
for line in reversed(raw.splitlines()):
    line = line.strip()
    if not line.startswith("{"):
        continue
    try:
        candidate = json.loads(line)
        if isinstance(candidate, dict) and "pending" in candidate and "unknownApplied" in candidate:
            parsed = candidate
            break
    except Exception:
        continue
if parsed is None:
    print(json.dumps({"valid": False}))
    sys.exit(1)
print(json.dumps({
    "valid": True,
    "pending_count": len(parsed.get("pending") or []),
    "unknown_applied_count": len(parsed.get("unknownApplied") or []),
    "known_applied_count": len(parsed.get("knownApplied") or []),
    "pending": parsed.get("pending") or [],
    "unknownApplied": parsed.get("unknownApplied") or [],
}))
'
}

probe_emdash_migrations() {
	local out="" rc=0
	if [[ ! -d "${SITE_DIR}/node_modules" ]]; then
		printf '{"supported":false,"reason":"node_modules missing"}\n'
		return 0
	fi
	if ! run_as_app_user "cd '${SITE_DIR}' && COREPACK_ENABLE_DOWNLOAD_PROMPT=0 pnpm exec emdash migrate --help >/dev/null 2>&1"; then
		printf '{"supported":false,"reason":"emdash migrate CLI unavailable"}\n'
		return 0
	fi
	set +e
	out="$(run_as_app_user "set -a; [[ -f '${APP_ENV_FILE}' ]] && . '${APP_ENV_FILE}'; set +a; cd '${SITE_DIR}' && COREPACK_ENABLE_DOWNLOAD_PROMPT=0 pnpm exec emdash migrate --status --json" 2>&1)"
	rc=$?
	set -e
	local parsed=""
	parsed="$(printf '%s\n' "${out}" | parse_migrate_status_json 2>/dev/null || printf '{"valid":false}')"
	PARSED="${parsed}" RC="${rc}" python3 - <<'PY'
import json
import os

data = json.loads(os.environ["PARSED"])
data["supported"] = True
data["exit_code"] = int(os.environ["RC"])
print(json.dumps(data))
PY
}

doctor_command() {
	local as_json="${1:-0}"
	local deep="${2:-0}"
	local checks_file=""
	checks_file="$(mktemp)"
	DOCTOR_CHECKS_FILE="${checks_file}"
	trap 'rm -f "${DOCTOR_CHECKS_FILE:-}"' RETURN

	add_check() {
		local name="$1" status="$2" detail="$3" remediation="${4:-}"
		local safe_detail=""
		safe_detail="$(printf '%s' "${detail}" | redact_sensitive_text)"
		NAME="${name}" STATUS="${status}" DETAIL="${safe_detail}" REMEDIATION="${remediation}" python3 - <<'PY' >>"${checks_file}"
import json, os
print(json.dumps({
    "name": os.environ["NAME"],
    "status": os.environ["STATUS"],
    "detail": os.environ["DETAIL"],
    "remediation": os.environ["REMEDIATION"],
}, ensure_ascii=False))
PY
	}

	local app_health_status="fail" setup_api_status="fail" app_service_status="fail"
	curl -fsS --max-time 5 "$(local_health_url)" >/dev/null 2>&1 && app_health_status="ok"
	curl -fsS --max-time 5 "$(local_setup_url)" >/dev/null 2>&1 && setup_api_status="ok"
	bool_active "${APP_SYSTEMD_SERVICE}" && app_service_status="ok"

	[[ -f "${ENV_FILE}" ]] && add_check "env file" "ok" "${ENV_FILE}" "" || add_check "env file" "fail" "${ENV_FILE}" "Run install.sh to regenerate ${ENV_FILE}"
	[[ -d "${SITE_DIR}" ]] && add_check "site dir" "ok" "${SITE_DIR}" "" || add_check "site dir" "fail" "${SITE_DIR}" "Verify SITE_DIR exists"

	if command -v node >/dev/null 2>&1; then
		local node_ver node_major node_minor
		node_ver="$(node --version 2>/dev/null || echo unknown)"
		node_major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
		node_minor="$(node -p 'process.versions.node.split(".")[1]' 2>/dev/null || echo 0)"
		if (( node_major > 22 || (node_major == 22 && node_minor >= 16) )); then
			add_check "node" "ok" "${node_ver} ($(command -v node))" ""
		else
			add_check "node" "fail" "${node_ver} (< 22.16 required by EmDash 1.6+)" "Upgrade Node.js to 24.x via NodeSource"
		fi
	else
		add_check "node" "fail" "node not found" "Install Node.js 24"
	fi

	if command -v pnpm >/dev/null 2>&1 || command -v corepack >/dev/null 2>&1; then
		add_check "pnpm" "ok" "$(command -v pnpm 2>/dev/null || command -v corepack)" ""
	else
		add_check "pnpm" "fail" "pnpm/corepack not found" "Run corepack enable"
	fi

	add_check "app service" "${app_service_status}" "${APP_SYSTEMD_SERVICE}" "$([[ "${app_service_status}" == "ok" ]] && echo "" || echo "Check journalctl -u ${APP_SYSTEMD_SERVICE}")"
	add_check "app health" "${app_health_status}" "${APP_PUBLIC_URL:-http://127.0.0.1:${APP_PORT}}/healthz" "$([[ "${app_health_status}" == "ok" ]] && echo "" || echo "Inspect app logs via emdashctl logs app")"
	add_check "setup api" "${setup_api_status}" "${APP_PUBLIC_URL:-http://127.0.0.1:${APP_PORT}}/_emdash/api/setup/status" "$([[ "${setup_api_status}" == "ok" ]] && echo "" || echo "Check EmDash backend readiness")"

	if [[ "${BACKUP_ENABLED}" == "1" ]]; then
		if [[ -f "/etc/cron.d/emdash-backup" ]]; then
			add_check "backup schedule" "ok" "/etc/cron.d/emdash-backup" ""
		else
			add_check "backup schedule" "fail" "/etc/cron.d/emdash-backup missing" "Re-run installer or create /etc/cron.d/emdash-backup"
		fi
	else
		add_check "backup schedule" "skipped" "BACKUP_ENABLED=0" ""
	fi

	if [[ "${deep}" == "1" ]]; then
		# Disk space check
		local avail_mb
		avail_mb="$(df -Pm "${ROOT_DIR}" 2>/dev/null | awk 'NR==2 {print $4}' || echo 0)"
		if [[ "${avail_mb}" =~ ^[0-9]+$ ]] && (( avail_mb >= 1024 )); then
			add_check "disk space" "ok" "${avail_mb} MiB available on ${ROOT_DIR}" ""
		elif [[ "${avail_mb}" =~ ^[0-9]+$ ]] && (( avail_mb >= 256 )); then
			add_check "disk space" "warn" "${avail_mb} MiB available on ${ROOT_DIR}" "Free disk space or prune old backups"
		else
			add_check "disk space" "fail" "${avail_mb} MiB available on ${ROOT_DIR}" "Free disk space immediately"
		fi

		# Encryption key check (never expose plaintext)
		if [[ -n "${EMDASH_ENCRYPTION_KEY:-}" ]]; then
			local key_kid=""
			if declare -F emdash_encryption_key_fingerprint >/dev/null 2>&1; then
				key_kid="$(emdash_encryption_key_fingerprint "${EMDASH_ENCRYPTION_KEY}" 2>/dev/null || true)"
			fi
			if [[ -n "${key_kid}" ]]; then
				add_check "encryption key" "ok" "configured (kid=${key_kid})" ""
			else
				add_check "encryption key" "fail" "EMDASH_ENCRYPTION_KEY format invalid" "Regenerate with pnpm exec emdash secrets generate"
			fi
		else
			add_check "encryption key" "warn" "EMDASH_ENCRYPTION_KEY is not set" "Set EMDASH_ENCRYPTION_KEY via emdash secrets generate to enable encrypted plugin settings"
		fi

		# Database connectivity & integrity
		if [[ "${DB_DRIVER}" == "sqlite" ]]; then
			if [[ -f "${SQLITE_PATH}" ]]; then
				local integrity
				integrity="$(python3 - "${SQLITE_PATH}" <<'PY' 2>&1 || true
import sqlite3, sys
conn = sqlite3.connect(sys.argv[1])
res = conn.execute("PRAGMA integrity_check;").fetchone()
conn.close()
print(res[0] if res else "unknown")
PY
)"
				if [[ "${integrity}" == "ok" ]]; then
					add_check "database" "ok" "sqlite integrity ok (${SQLITE_PATH})" ""
				else
					add_check "database" "fail" "sqlite integrity check: ${integrity}" "Restore from verified backup"
				fi
			else
				add_check "database" "warn" "sqlite file not yet initialized (${SQLITE_PATH})" "Start app service to initialize SQLite database"
			fi
		else
			if bool_active "${POSTGRES_SERVICE:-postgresql}" && PGPASSWORD="${PG_DB_PASSWORD:-}" psql -h "${POSTGRES_HOST:-127.0.0.1}" -p "${POSTGRES_PORT:-5432}" -U "${PG_DB_USER:-emdash}" -d "${PG_DB_NAME:-emdash}" -tAc "SELECT 1" >/dev/null 2>&1; then
				add_check "database" "ok" "postgres connected (${POSTGRES_SERVICE:-postgresql})" ""
			else
				add_check "database" "fail" "postgres connection failed (${POSTGRES_SERVICE:-postgresql})" "Check systemctl status ${POSTGRES_SERVICE:-postgresql} and credentials"
			fi
		fi

		# Session backend check
		if [[ "${SESSION_DRIVER}" == "redis" ]]; then
			local cli_bin=""
			command -v valkey-cli >/dev/null 2>&1 && cli_bin="valkey-cli"
			[[ -z "${cli_bin}" ]] && command -v redis-cli >/dev/null 2>&1 && cli_bin="redis-cli"
			if bool_active "${REDIS_SERVICE:-valkey}" && [[ -n "${cli_bin}" ]] && REDISCLI_AUTH="${REDIS_PASSWORD:-}" "${cli_bin}" -h "${REDIS_HOST:-127.0.0.1}" -p "${REDIS_PORT:-6379}" ping 2>/dev/null | grep -qx "PONG"; then
				add_check "session store" "ok" "valkey/redis PONG (${REDIS_SERVICE:-valkey})" ""
			else
				add_check "session store" "fail" "valkey/redis ping failed (${REDIS_SERVICE:-valkey})" "Check systemctl status ${REDIS_SERVICE:-valkey}"
			fi
		else
			[[ -d "${SESSIONS_DIR}" ]] && add_check "session store" "ok" "file sessions dir present (${SESSIONS_DIR})" "" || add_check "session store" "fail" "sessions dir missing (${SESSIONS_DIR})" "Create ${SESSIONS_DIR}"
		fi

		# Migration status probe
		local mig_json mig_supported mig_valid mig_pending mig_unknown
		mig_json="$(probe_emdash_migrations)"
		mig_supported="$(printf '%s' "${mig_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("supported", False))' 2>/dev/null || echo False)"
		if [[ "${mig_supported}" == "True" ]]; then
			mig_valid="$(printf '%s' "${mig_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("valid", False))' 2>/dev/null || echo False)"
			mig_pending="$(printf '%s' "${mig_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("pending_count", 0))' 2>/dev/null || echo 0)"
			mig_unknown="$(printf '%s' "${mig_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("unknown_applied_count", 0))' 2>/dev/null || echo 0)"
			if [[ "${mig_valid}" != "True" ]]; then
				add_check "migrations" "warn" "emdash migrate --status returned unparseable output" "Run pnpm exec emdash migrate --status manually"
			elif (( mig_unknown > 0 )); then
				add_check "migrations" "fail" "${mig_unknown} unknown applied migrations detected (code older than DB)" "Upgrade app or inspect database migration history"
			elif (( mig_pending > 0 )); then
				add_check "migrations" "warn" "${mig_pending} pending migrations" "Run pnpm exec emdash migrate"
			else
				add_check "migrations" "ok" "all migrations applied (0 pending)" ""
			fi
		else
			add_check "migrations" "skipped" "emdash migrate CLI not available in current site" ""
		fi

		# Plugin sandbox (workerd) check
		if [[ "${ENABLE_PLUGIN_SANDBOX:-1}" == "1" ]]; then
			local workerd_ok="0"
			if run_as_app_user "cd '${SITE_DIR}' && node -e 'import(\"@emdash-cms/sandbox-workerd/sandbox\").then(() => process.exit(0)).catch(() => process.exit(1))'" >/dev/null 2>&1; then
				workerd_ok="1"
			fi
			if [[ "${workerd_ok}" == "1" ]]; then
				add_check "plugin sandbox" "ok" "@emdash-cms/sandbox-workerd importable by ${APP_RUN_USER}" ""
			else
				add_check "plugin sandbox" "warn" "@emdash-cms/sandbox-workerd not importable in ${SITE_DIR}" "Install @emdash-cms/sandbox-workerd and workerd or disable ENABLE_PLUGIN_SANDBOX"
			fi
		else
			add_check "plugin sandbox" "skipped" "ENABLE_PLUGIN_SANDBOX=0" ""
		fi

		# Caddy / TLS check
		if [[ "${USE_CADDY}" == "1" ]]; then
			if bool_active caddy && caddy validate --config /etc/caddy/Caddyfile >/dev/null 2>&1; then
				add_check "caddy" "ok" "caddy active and Caddyfile valid" ""
			else
				add_check "caddy" "fail" "caddy inactive or invalid Caddyfile" "Run caddy validate --config /etc/caddy/Caddyfile"
			fi
			if [[ "${ENABLE_HTTPS}" == "1" && -n "${DOMAIN:-}" ]] && command -v openssl >/dev/null 2>&1; then
				local cert_end=""
				cert_end="$(timeout 5 openssl s_client -servername "${DOMAIN}" -connect "127.0.0.1:443" </dev/null 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2 || true)"
				if [[ -n "${cert_end}" ]]; then
					add_check "tls cert" "ok" "expires ${cert_end}" ""
				else
					add_check "tls cert" "warn" "unable to read local TLS cert for ${DOMAIN}:443" "Check journalctl -u caddy for ACME status"
				fi
			fi
		else
			add_check "caddy" "skipped" "USE_CADDY=0" ""
		fi

		# S3 connectivity check (storage or backup)
		if [[ "${STORAGE_DRIVER}" == "s3" || "${BACKUP_TARGET_TYPE}" == "s3" ]]; then
			local s3_ep s3_reg s3_bkt s3_ak s3_sk
			if [[ "${STORAGE_DRIVER}" == "s3" ]]; then
				s3_ep="${S3_ENDPOINT:-}"; s3_reg="${S3_REGION:-auto}"; s3_bkt="${S3_BUCKET:-}"; s3_ak="${S3_ACCESS_KEY_ID:-}"; s3_sk="${S3_SECRET_ACCESS_KEY:-}"
			else
				s3_ep="${BACKUP_S3_ENDPOINT:-}"; s3_reg="${BACKUP_S3_REGION:-auto}"; s3_bkt="${BACKUP_S3_BUCKET:-}"; s3_ak="${BACKUP_S3_ACCESS_KEY_ID:-}"; s3_sk="${BACKUP_S3_SECRET_ACCESS_KEY:-}"
			fi
			local s3_check_out=""
			if s3_check_out="$(python3 - "${s3_ep}" "${s3_reg}" "${s3_bkt}" "${s3_ak}" "${s3_sk}" <<'PY' 2>&1
import sys
try:
    import boto3
    from botocore.config import Config
except ImportError:
    print("boto3 missing")
    sys.exit(2)
ep, reg, bkt, ak, sk = sys.argv[1:]
client = boto3.client("s3", endpoint_url=ep, region_name=reg, aws_access_key_id=ak, aws_secret_access_key=sk, config=Config(signature_version="s3v4", connect_timeout=5, read_timeout=5))
client.head_bucket(Bucket=bkt)
print("head_bucket ok")
PY
)"; then
				add_check "s3 storage" "ok" "bucket ${s3_bkt} reachable" ""
			else
				add_check "s3 storage" "fail" "s3 check failed: ${s3_check_out}" "Verify python3-boto3 and S3 credentials"
			fi
		fi
	fi

	local report_json=""
	report_json="$(CHECKS_FILE="${checks_file}" DEEP_MODE="${deep}" python3 - <<'PY'
import json
import os
from pathlib import Path

checks = [json.loads(line) for line in Path(os.environ["CHECKS_FILE"]).read_text().splitlines() if line.strip()]
fail_count = sum(1 for c in checks if c["status"] == "fail")
warn_count = sum(1 for c in checks if c["status"] == "warn")
ok_count = sum(1 for c in checks if c["status"] == "ok")
skipped_count = sum(1 for c in checks if c["status"] == "skipped")

print(json.dumps({
    "schema_version": 1,
    "mode": "deep" if os.environ["DEEP_MODE"] == "1" else "standard",
    "healthy": fail_count == 0,
    "summary": {
        "ok": ok_count,
        "warn": warn_count,
        "fail": fail_count,
        "skipped": skipped_count,
    },
    "checks": checks,
}, ensure_ascii=False, indent=2))
PY
)"

	rm -f "${checks_file}"
	DOCTOR_CHECKS_FILE=""
	trap - RETURN

	if [[ "${as_json}" == "1" ]]; then
		printf '%s\n' "${report_json}"
		return
	fi

	printf '%s\n' "${report_json}" | python3 -c '
import json, sys
data = json.load(sys.stdin)
for c in data["checks"]:
    tag = c["status"].upper()
    name = c["name"]
    detail = c["detail"]
    print(f"[{tag}] {name}: {detail}")
    if c["status"] in ("fail", "warn") and c.get("remediation"):
        rem = c["remediation"]
        print(f"       -> {rem}")
'
}

