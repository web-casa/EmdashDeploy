	local target_key="${requested_key}"
	if [[ "${requested_key}" == "latest" ]]; then
		target_key="$(list_s3_backups_json | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d[0]["key"] if d else "")')"
		[[ -n "${target_key}" ]] || fail "No EmDash backups found in S3 bucket ${BACKUP_S3_BUCKET}/${BACKUP_S3_PREFIX}."
	fi

	local base_name=""
	base_name="$(basename "${target_key}")"
	local dest_file="${dest_dir}/${base_name}"
	BACKUP_S3_ENDPOINT="${BACKUP_S3_ENDPOINT}" \
	BACKUP_S3_REGION="${BACKUP_S3_REGION:-auto}" \
