collect_service_state_json() {
	local unit="$1"
	if ! command -v systemctl >/dev/null 2>&1; then
		UNIT="${unit}" python3 -c 'import json,os; print(json.dumps({"unit": os.environ["UNIT"], "available": False}))'
		return 0
	fi
	local show_out=""
	show_out="$(systemctl show "${unit}" -p ActiveState -p SubState -p NRestarts -p ExecMainStatus -p MainPID --value 2>/dev/null || true)"
	UNIT="${unit}" SHOW_OUT="${show_out}" python3 - <<'PY'
import json, os
lines = os.environ.get("SHOW_OUT", "").splitlines()
if len(lines) < 5:
    print(json.dumps({"unit": os.environ["UNIT"], "available": False}))
else:
    def to_int(v):
        try:
            return int(v)
        except Exception:
            return 0
    print(json.dumps({
        "unit": os.environ["UNIT"],
        "available": True,
        "active_state": lines[0],
        "sub_state": lines[1],
        "restarts": to_int(lines[2]),
        "exec_main_status": to_int(lines[3]),
        "main_pid": to_int(lines[4]),
    }))
PY
}

collect_service_logs_json() {
	local unit="$1"
	local max_lines="${2:-80}"
	local max_bytes="${3:-32768}"
	local redact_ips="${4:-1}"

	if ! command -v journalctl >/dev/null 2>&1; then
		UNIT="${unit}" python3 -c 'import json,os; print(json.dumps({"unit": os.environ["UNIT"], "available": False, "entries": [], "entry_count": 0, "bytes": 0, "truncated": False}))'
		return 0
	fi

	local raw_file=""
	raw_file="$(mktemp)"
	DIAG_LOG_TMP="${raw_file}"
	trap 'rm -f "${DIAG_LOG_TMP:-}"' RETURN

	if ! journalctl -u "${unit}" -n "${max_lines}" -o json --no-pager >"${raw_file}" 2>/dev/null; then
		rm -f "${raw_file}"
		DIAG_LOG_TMP=""
		trap - RETURN
		UNIT="${unit}" python3 -c 'import json,os; print(json.dumps({"unit": os.environ["UNIT"], "available": False, "entries": [], "entry_count": 0, "bytes": 0, "truncated": False}))'
		return 0
	fi

	local parsed_json=""
	parsed_json="$(
		UNIT="${unit}" MAX_BYTES="${max_bytes}" RAW_FILE="${raw_file}" python3 - <<'PY'
import datetime, json, os
from pathlib import Path

unit = os.environ["UNIT"]
max_bytes = int(os.environ["MAX_BYTES"])
max_entry_bytes = 4096
raw_lines = Path(os.environ["RAW_FILE"]).read_text(errors="replace").splitlines()

entries = []
total_bytes = 0
truncated = False

for line in raw_lines:
    line = line.strip()
    if not line:
        continue
    ts_iso = ""
    priority = ""
    msg = ""
    try:
        obj = json.loads(line)
        rt = obj.get("__REALTIME_TIMESTAMP")
        if rt is not None:
            try:
                dt = datetime.datetime.fromtimestamp(int(rt) / 1_000_000, tz=datetime.timezone.utc)
                ts_iso = dt.strftime("%Y-%m-%dT%H:%M:%SZ")
            except Exception:
                ts_iso = str(rt)
        priority = str(obj.get("PRIORITY", ""))
        raw_msg = obj.get("MESSAGE", "")
        if isinstance(raw_msg, list):
            msg = bytes(int(b) & 0xFF for b in raw_msg).decode("utf-8", errors="replace")
        else:
            msg = str(raw_msg)
    except Exception:
        msg = line

    msg_bytes = msg.encode("utf-8", errors="replace")
    if len(msg_bytes) > max_entry_bytes:
        msg = msg_bytes[:max_entry_bytes].decode("utf-8", errors="ignore") + "...[TRUNCATED]"
        truncated = True

    entry = {"timestamp": ts_iso, "priority": priority, "message": msg}
    entry_size = len(json.dumps(entry, ensure_ascii=False).encode("utf-8"))
    if total_bytes + entry_size > max_bytes:
        truncated = True
        break
    entries.append(entry)
    total_bytes += entry_size

print(json.dumps({
    "unit": unit,
    "available": True,
    "entry_count": len(entries),
    "bytes": total_bytes,
    "truncated": truncated,
    "entries": entries,
}, ensure_ascii=False))
PY
	)"

	rm -f "${raw_file}"
	DIAG_LOG_TMP=""
	trap - RETURN

	EMDASH_REDACT_IPS="${redact_ips}" redact_sensitive_text <<<"${parsed_json}"
}

diagnose_command() {
	local as_json="0"
	local lines="80"
	local out_file=""
	local redact_ips="1"

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--json) as_json="1" ;;
		--no-ip-redact) redact_ips="0" ;;
		--lines=*) lines="${1#--lines=}" ;;
		--lines)
			shift
			[[ $# -gt 0 ]] || fail "Missing value for --lines"
			lines="$1"
			;;
		--out=*) out_file="${1#--out=}" ;;
		--out)
			shift
			[[ $# -gt 0 ]] || fail "Missing value for --out"
			out_file="$1"
			;;
		*) fail "Unknown diagnose option: $1" ;;
		esac
		shift
	done

	if ! [[ "${lines}" =~ ^[0-9]+$ ]] || (( lines < 1 || lines > 500 )); then
		fail "--lines must be an integer between 1 and 500 (got: ${lines})"
	fi

	if [[ -n "${out_file}" ]]; then
		if [[ -L "${out_file}" ]]; then
			fail "Refusing to write diagnostic bundle to symlink: ${out_file}"
		fi
		if [[ -d "${out_file}" ]]; then
			fail "Refusing to write diagnostic bundle to directory: ${out_file}"
		fi
	fi

	local doctor_json="" migrations_json="" key_kids=""
	doctor_json="$(EMDASH_REDACT_IPS="${redact_ips}" doctor_command 1 1)"
	migrations_json="$(probe_emdash_migrations)"
	if [[ -n "${EMDASH_ENCRYPTION_KEY:-}" ]] && declare -F emdash_encryption_key_fingerprint >/dev/null 2>&1; then
		key_kids="$(emdash_encryption_key_fingerprint "${EMDASH_ENCRYPTION_KEY}" 2>/dev/null || true)"
	fi

	local diag_tmp=""
	diag_tmp="$(mktemp -d)"
	DIAGNOSE_TMP_DIR="${diag_tmp}"
	trap 'rm -rf "${DIAGNOSE_TMP_DIR:-}"' RETURN

	printf '%s\n' "${doctor_json}" >"${diag_tmp}/doctor.json"
	printf '%s\n' "${migrations_json}" >"${diag_tmp}/migrations.json"

	local -a svc_roles=("app")
	[[ "${DB_DRIVER}" == "postgres" ]] && svc_roles+=("postgres")
	[[ "${SESSION_DRIVER}" == "redis" ]] && svc_roles+=("redis")
	[[ "${USE_CADDY}" == "1" ]] && svc_roles+=("caddy")

	mkdir -p "${diag_tmp}/services" "${diag_tmp}/logs"
	local role="" unit=""
	for role in "${svc_roles[@]}"; do
		unit="$(service_name_for "${role}" 2>/dev/null || true)"
		[[ -n "${unit}" ]] || continue
		collect_service_state_json "${unit}" >"${diag_tmp}/services/${role}.json"
		collect_service_logs_json "${unit}" "${lines}" 32768 "${redact_ips}" >"${diag_tmp}/logs/${role}.json"
	done

	local avail_mb="" disk_use=""
	avail_mb="$(df -Pm "${ROOT_DIR}" 2>/dev/null | awk 'NR==2 {print $4}' || echo 0)"
	disk_use="$(df -Pm "${ROOT_DIR}" 2>/dev/null | awk 'NR==2 {print $5}' || echo unknown)"

	local raw_bundle=""
	raw_bundle="$(
		DIAG_DIR="${diag_tmp}" \
		SITE_DIR="${SITE_DIR}" \
		ROOT_DIR="${ROOT_DIR}" \
		APP_PORT="${APP_PORT}" \
		APP_PUBLIC_URL="${APP_PUBLIC_URL:-}" \
		PROJECT_NAME="${PROJECT_NAME:-}" \
		TEMPLATE="${TEMPLATE:-}" \
		DB_DRIVER="${DB_DRIVER}" \
		SESSION_DRIVER="${SESSION_DRIVER}" \
		STORAGE_DRIVER="${STORAGE_DRIVER}" \
		USE_CADDY="${USE_CADDY}" \
		ENABLE_HTTPS="${ENABLE_HTTPS}" \
		ENABLE_PLUGIN_SANDBOX="${ENABLE_PLUGIN_SANDBOX:-1}" \
		BACKUP_ENABLED="${BACKUP_ENABLED}" \
