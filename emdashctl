rotate_encryption_key_command() {
	local mode="rotate"
	local as_json="0"
	local dry_run="0"
	local assume_yes="0"
	local confirm_prune_kid=""
	local force_prune="0"

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--status) mode="status" ;;
		--prune-old) mode="prune" ;;
		--json) as_json="1" ;;
		--dry-run) dry_run="1" ;;
		--yes | -y) assume_yes="1" ;;
		--force-prune) force_prune="1" ;;
		--confirm-prune-kid=*) confirm_prune_kid="${1#--confirm-prune-kid=}" ;;
		--confirm-prune-kid)
			shift
			[[ $# -gt 0 ]] || fail "Missing value for --confirm-prune-kid"
			confirm_prune_kid="$1"
			;;
		*) fail "Unknown rotate-encryption-key option: $1" ;;
		esac
		shift
	done

	local current_raw="${EMDASH_ENCRYPTION_KEY:-}"
	if [[ -z "${current_raw}" ]]; then
		fail "EMDASH_ENCRYPTION_KEY is not configured in ${APP_ENV_FILE}."
	fi
	if ! validate_emdash_encryption_key "${current_raw}"; then
		fail "Current EMDASH_ENCRYPTION_KEY format is invalid."
	fi

	local current_kids_csv=""
	current_kids_csv="$(emdash_encryption_key_fingerprint "${current_raw}")"

	local key_meta=""
	key_meta="$(
		RAW_KEYS="${current_raw}" KIDS_CSV="${current_kids_csv}" python3 - <<'PY'
import json, os
parts = [p.strip() for p in os.environ["RAW_KEYS"].split(",") if p.strip()]
kids = [k.strip() for k in os.environ["KIDS_CSV"].split(",") if k.strip()]
print(json.dumps({
    "key_count": len(parts),
    "primary_key": parts[0],
    "primary_kid": kids[0],
    "legacy_kids": kids[1:],
    "all_kids": kids,
}))
PY
	)"

	local key_count primary_key primary_kid legacy_kids_csv
	key_count="$(printf '%s' "${key_meta}" | python3 -c 'import json,sys; print(json.load(sys.stdin)["key_count"])')"
	primary_key="$(printf '%s' "${key_meta}" | python3 -c 'import json,sys; print(json.load(sys.stdin)["primary_key"])')"
	primary_kid="$(printf '%s' "${key_meta}" | python3 -c 'import json,sys; print(json.load(sys.stdin)["primary_kid"])')"
	legacy_kids_csv="$(printf '%s' "${key_meta}" | python3 -c 'import json,sys; print(",".join(json.load(sys.stdin)["legacy_kids"]))')"

	if [[ "${mode}" == "status" ]]; then
		local scan_json=""
		scan_json="$(scan_db_encrypted_kid_refs)"
		local status_out=""
		status_out="$(
			KEY_META="${key_meta}" SCAN_JSON="${scan_json}" python3 - <<'PY'
import json, os
meta = json.loads(os.environ["KEY_META"])
scan = json.loads(os.environ["SCAN_JSON"])
print(json.dumps({
    "key_count": meta["key_count"],
    "primary_kid": meta["primary_kid"],
    "legacy_kids": meta["legacy_kids"],
    "db_scan": scan,
}, ensure_ascii=False, indent=2))
PY
		)"
		if [[ "${as_json}" == "1" ]]; then
			printf '%s\n' "${status_out}"
			return 0
		fi
		printf '%s\n' "${status_out}" | python3 -c '
import json, sys
d = json.load(sys.stdin)
kc = d["key_count"]
pk = d["primary_kid"]
lk = d["legacy_kids"]
scan = d["db_scan"]
counts = scan.get("counts") or {}
print(f"Encryption keys configured: {kc}")
print(f"  Primary encryption kid: {pk} (DB encrypted refs: {counts.get(pk, 0)})")
if lk:
    print("  Legacy decryption kids:")
    for kid in lk:
        cnt = counts.get(kid, 0)
        tbls = (scan.get("tables") or {}).get(kid, [])
        tbl_info = f" in {tbls}" if tbls else ""
        print(f"    - {kid} (DB encrypted refs: {cnt}{tbl_info})")
else:
    print("  Legacy decryption kids: none")
if not scan.get("checked"):
    err = scan.get("error", "unknown")
    print(f"  [WARN] Database scan incomplete: {err}")
'
		return 0
	fi

	local health_tries="${EMDASHCTL_HEALTH_TRIES:-30}"
	local setup_tries="${EMDASHCTL_SETUP_TRIES:-15}"

	if [[ "${mode}" == "rotate" ]]; then
		local new_key="" new_kid="" next_raw="" next_kids_csv=""
		new_key="$(generate_rotated_encryption_key)"
		new_kid="$(emdash_encryption_key_fingerprint "${new_key}")"
		next_raw="${new_key},${current_raw}"
		next_kids_csv="${new_kid},${current_kids_csv}"

		if [[ "${dry_run}" == "1" ]]; then
			log "Dry-run: Stage 1 encryption key rotation plan:"
			log "  Current primary kid: ${primary_kid} (total keys: ${key_count})"
			log "  New primary kid:     ${new_kid}"
			log "  Resulting key kids:  ${next_kids_csv} (old keys preserved for decryption)"
			log "Dry-run complete. No files or services were modified."
			return 0
		fi

		if [[ "${assume_yes}" != "1" && -t 0 ]]; then
			local ans=""
			read -r -p "Prepend new encryption key (kid=${new_kid}) before existing kid=${primary_kid} and restart ${APP_SYSTEMD_SERVICE}? [y/N]: " ans
			[[ "${ans,,}" == "y" || "${ans,,}" == "yes" ]] || fail "Key rotation aborted by user."
		fi

		acquire_op_lock
		umask 0077
		local snap_dir=""
		snap_dir="$(mktemp -d)"
		chmod 0700 "${snap_dir}"
		ROTATE_SNAP_DIR="${snap_dir}"
		trap 'rm -rf "${ROTATE_SNAP_DIR:-}"' RETURN

		cp -a "${APP_ENV_FILE}" "${snap_dir}/emdash.env"
		[[ -f "${INSTALL_YAML}" ]] && cp -a "${INSTALL_YAML}" "${snap_dir}/install.yml"

		rollback_rotate_files() {
			if [[ -f "${snap_dir}/emdash.env" ]]; then
				cp -a "${snap_dir}/emdash.env" "${APP_ENV_FILE}"
			fi
			if [[ -f "${snap_dir}/install.yml" ]]; then
				cp -a "${snap_dir}/install.yml" "${INSTALL_YAML}"
			fi
			systemctl restart "${APP_SYSTEMD_SERVICE}" >/dev/null 2>&1 || true
		}

		if ! update_env_value "EMDASH_ENCRYPTION_KEY" "${next_raw}" "${APP_ENV_FILE}"; then
			rollback_rotate_files
			rm -rf "${snap_dir}"
			ROTATE_SNAP_DIR=""
			trap - RETURN
			fail "Failed to update ${APP_ENV_FILE}; rolled back."
		fi
		if declare -F update_install_yaml_encryption_kid >/dev/null 2>&1; then
			update_install_yaml_encryption_kid "${next_kids_csv}" "${INSTALL_YAML}" || true
		fi

		if ! { systemctl restart "${APP_SYSTEMD_SERVICE}" && wait_http_ok "$(local_health_url)" "${health_tries}" && wait_http_ok "$(local_setup_url)" "${setup_tries}"; }; then
			warn "Health check failed after Stage 1 key rotation; rolling back emdash.env and install.yml."
			rollback_rotate_files
			rm -rf "${snap_dir}"
			ROTATE_SNAP_DIR=""
			trap - RETURN
			fail "Stage 1 encryption key rotation failed health verification; previous configuration restored."
		fi

		rm -rf "${snap_dir}"
		ROTATE_SNAP_DIR=""
		trap - RETURN
		release_op_lock

		log "Stage 1 encryption key rotation complete: primary kid ${primary_kid} -> ${new_kid}"
		log "Active encryption kids: ${next_kids_csv}"
		log "Next steps:"
		log "  1. Back up the updated ${APP_ENV_FILE} immediately."
		log "  2. Re-save encrypted plugin settings in EmDash admin so they re-encrypt under kid=${new_kid}."
		log "  3. Verify zero legacy DB references with: emdashctl rotate-encryption-key --status"
		log "  4. Prune legacy key(s) once ready: emdashctl rotate-encryption-key --prune-old --confirm-prune-kid ${current_kids_csv}"
		return 0
	fi

	# Stage 2: --prune-old
	if (( key_count < 2 )); then
		fail "Only 1 encryption key is configured (kid=${primary_kid}); nothing to prune."
	fi

	local scan_json="" scan_checked="" legacy_refs="0" legacy_detail=""
	scan_json="$(scan_db_encrypted_kid_refs)"
	scan_checked="$(printf '%s' "${scan_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("checked", False))')"
	legacy_refs="$(
		SCAN_JSON="${scan_json}" LEGACY_KIDS="${legacy_kids_csv}" python3 - <<'PY'
import json, os
scan = json.loads(os.environ["SCAN_JSON"])
counts = scan.get("counts") or {}
kids = [k for k in os.environ["LEGACY_KIDS"].split(",") if k]
print(sum(int(counts.get(k, 0)) for k in kids))
PY
	)"
	legacy_detail="$(
		SCAN_JSON="${scan_json}" LEGACY_KIDS="${legacy_kids_csv}" python3 - <<'PY'
import json, os
scan = json.loads(os.environ["SCAN_JSON"])
counts = scan.get("counts") or {}
tables = scan.get("tables") or {}
parts = []
for k in [x for x in os.environ["LEGACY_KIDS"].split(",") if x]:
    c = int(counts.get(k, 0))
    t = tables.get(k, [])
    parts.append(f"{k}:{c}" + (f"({','.join(t)})" if t else ""))
print(", ".join(parts))
PY
	)"

	if [[ "${dry_run}" == "1" ]]; then
		log "Dry-run: Stage 2 encryption key prune plan:"
		log "  Keep primary kid:   ${primary_kid}"
		log "  Prune legacy kids:  ${legacy_kids_csv}"
		log "  DB scan checked:    ${scan_checked} | legacy refs: ${legacy_refs} (${legacy_detail})"
		log "Dry-run complete. No files or services were modified."
		return 0
	fi

	if [[ "${scan_checked}" != "True" && "${force_prune}" != "1" ]]; then
		fail "Database encrypted-envelope scan could not complete; refusing to prune legacy key(s) (${legacy_kids_csv}). Pass --force-prune only if you are certain no values use the legacy key(s)."
	fi

	if (( legacy_refs > 0 )) && [[ "${force_prune}" != "1" ]]; then
		fail "Refusing to prune legacy encryption key(s): found ${legacy_refs} database value(s) still encrypted under legacy kid(s) [${legacy_detail}]. Re-save those plugin settings in EmDash admin first, or pass --force-prune if intentional."
	fi

	# Strong kid-bound confirmation (plain --yes is NEVER sufficient for destructive key pruning)
	if [[ -n "${confirm_prune_kid}" ]]; then
		if [[ "${confirm_prune_kid}" != "${legacy_kids_csv}" ]]; then
			fail "--confirm-prune-kid value '${confirm_prune_kid}' does not match legacy kid(s) to prune '${legacy_kids_csv}'."
		fi
	else
		if [[ -t 0 ]]; then
			warn "Pruning legacy key(s) [${legacy_kids_csv}] is irreversible for any ciphertext still encrypted with them."
			warn "If historical backups depend on this key, create a fresh backup first."
			local typed_kid=""
			read -r -p "Type the exact legacy kid(s) '${legacy_kids_csv}' to confirm pruning: " typed_kid
			[[ "${typed_kid}" == "${legacy_kids_csv}" ]] || fail "Confirmation kid mismatch; prune aborted."
		else
			fail "Non-interactive --prune-old requires explicit --confirm-prune-kid '${legacy_kids_csv}' (--yes alone is not accepted)."
		fi
	fi

	acquire_op_lock
	umask 0077
	local snap_dir=""
	snap_dir="$(mktemp -d)"
	chmod 0700 "${snap_dir}"
	ROTATE_SNAP_DIR="${snap_dir}"
	trap 'rm -rf "${ROTATE_SNAP_DIR:-}"' RETURN

	cp -a "${APP_ENV_FILE}" "${snap_dir}/emdash.env"
	[[ -f "${INSTALL_YAML}" ]] && cp -a "${INSTALL_YAML}" "${snap_dir}/install.yml"

	rollback_prune_files() {
		if [[ -f "${snap_dir}/emdash.env" ]]; then
			cp -a "${snap_dir}/emdash.env" "${APP_ENV_FILE}"
		fi
		if [[ -f "${snap_dir}/install.yml" ]]; then
			cp -a "${snap_dir}/install.yml" "${INSTALL_YAML}"
		fi
		systemctl start "${APP_SYSTEMD_SERVICE}" >/dev/null 2>&1 || true
	}

	systemctl stop "${APP_SYSTEMD_SERVICE}" || true

	if ! update_env_value "EMDASH_ENCRYPTION_KEY" "${primary_key}" "${APP_ENV_FILE}"; then
		rollback_prune_files
		rm -rf "${snap_dir}"
		ROTATE_SNAP_DIR=""
		trap - RETURN
		fail "Failed to update ${APP_ENV_FILE} during prune; rolled back."
	fi
	if declare -F update_install_yaml_encryption_kid >/dev/null 2>&1; then
		update_install_yaml_encryption_kid "${primary_kid}" "${INSTALL_YAML}" || true
	fi

	if ! { systemctl start "${APP_SYSTEMD_SERVICE}" && wait_http_ok "$(local_health_url)" "${health_tries}" && wait_http_ok "$(local_setup_url)" "${setup_tries}"; }; then
		warn "Health check failed after Stage 2 key prune; rolling back emdash.env and install.yml."
		systemctl stop "${APP_SYSTEMD_SERVICE}" || true
		rollback_prune_files
		rm -rf "${snap_dir}"
		ROTATE_SNAP_DIR=""
		trap - RETURN
		fail "Stage 2 encryption key prune failed health verification; previous keys restored."
	fi

	rm -rf "${snap_dir}"
	ROTATE_SNAP_DIR=""
	trap - RETURN
	release_op_lock

	log "Stage 2 encryption key prune complete: removed legacy kid(s) [${legacy_kids_csv}], kept primary kid [${primary_kid}]."
}

reset_db_password_command() {
	[[ "${DB_DRIVER}" == "postgres" ]] || fail "$(ct reset_only_postgres)"
	acquire_op_lock
	local new_password old_password pg_user_encoded pg_password_encoded pg_db_name_encoded rollback_dir env_backup db_password_changed="0"
	new_password="$(openssl rand -hex 16)"
	old_password="${PG_DB_PASSWORD}"
	migrate_managed_script_paths_if_legacy
	rollback_dir="$(create_site_rollback)"
	env_backup="${rollback_dir}/emdash.env"
	cp -a "${APP_ENV_FILE}" "${env_backup}"
	systemctl stop "${APP_SYSTEMD_SERVICE}" || true
	if ! {
		postgres_alter_password "${PG_DB_USER}" "${new_password}" &&
		db_password_changed="1" &&
		update_env_value "PG_DB_PASSWORD" "${new_password}" "${APP_ENV_FILE}"
	}; then
		if [[ "${db_password_changed}" == "1" ]]; then
			postgres_alter_password "${PG_DB_USER}" "${old_password}" || true
		fi
		cp -a "${env_backup}" "${APP_ENV_FILE}" 2>/dev/null || true
		restore_site_rollback "${rollback_dir}"
		rm -rf "${rollback_dir}"
		systemctl start "${APP_SYSTEMD_SERVICE}" || true
		fail "Failed to update PostgreSQL password."
	fi
	pg_user_encoded="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "${PG_DB_USER}")"
	pg_password_encoded="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "${new_password}")"
	pg_db_name_encoded="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "${PG_DB_NAME}")"
	if ! update_env_value "DATABASE_URL" "postgres://${pg_user_encoded}:${pg_password_encoded}@${POSTGRES_HOST}:${POSTGRES_PORT}/${pg_db_name_encoded}" "${APP_ENV_FILE}"; then
		if [[ "${db_password_changed}" == "1" ]]; then
			postgres_alter_password "${PG_DB_USER}" "${old_password}" || true
		fi
		cp -a "${env_backup}" "${APP_ENV_FILE}" 2>/dev/null || true
		restore_site_rollback "${rollback_dir}"
		rm -rf "${rollback_dir}"
		systemctl start "${APP_SYSTEMD_SERVICE}" || true
		fail "Failed to update DATABASE_URL; previous password restored."
	fi

	# Never overwrite user's astro.config.mjs; verify real DB-backed setup API after restart,
	# and rebuild without mutating source if Astro baked the previous PG password at build time.
	systemctl start "${APP_SYSTEMD_SERVICE}"
	if ! { wait_http_ok "$(local_health_url)" 20 && wait_http_ok "$(local_setup_url)" 10; }; then
		log "App requires clean rebuild to pick up rotated PostgreSQL credentials (preserving user astro.config.mjs)."
		systemctl stop "${APP_SYSTEMD_SERVICE}" || true
		if ! run_as_app_user "'${APP_BUILD_SCRIPT}'" || ! { systemctl start "${APP_SYSTEMD_SERVICE}" && wait_http_ok "$(local_health_url)" 60 && wait_http_ok "$(local_setup_url)" 20; }; then
			warn "Application did not become healthy after password reset; rolling back."
			systemctl stop "${APP_SYSTEMD_SERVICE}" || true
			if [[ "${db_password_changed}" == "1" ]]; then
				postgres_alter_password "${PG_DB_USER}" "${old_password}" || true
			fi
			cp -a "${env_backup}" "${APP_ENV_FILE}" 2>/dev/null || true
			restore_site_rollback "${rollback_dir}"
			rm -rf "${rollback_dir}"
			systemctl start "${APP_SYSTEMD_SERVICE}" || true
			fail "Application did not become healthy after password reset; previous password and app files were restored."
		fi
	fi
	rm -rf "${rollback_dir}"
	printf '%s\n' "${new_password}"
}

instances_command() {
	local as_json="0"
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--json) as_json="1" ;;
		*) fail "Unknown instances option: $1" ;;
		esac
		shift
	done

	local base_dir="${EMDASH_INSTANCES_BASE_DIR:-/etc/emdash}"
	local out_json=""
	out_json="$(
		BASE_DIR="${base_dir}" python3 - <<'PY'
import json, os, shlex, subprocess
from pathlib import Path

base = Path(os.environ["BASE_DIR"])
candidates = []
default_env = base / "emdash.env"
if default_env.is_file():
    candidates.append(("default", default_env))
inst_dir = base / "instances"
if inst_dir.is_dir():
    for d in sorted(inst_dir.iterdir()):
        ef = d / "emdash.env"
        if d.is_dir() and ef.is_file():
            candidates.append((d.name, ef))

def parse_env(path: Path):
    data = {}
    for raw in path.read_text(errors="replace").splitlines():
        raw = raw.strip()
        if not raw or raw.startswith("#") or "=" not in raw:
            continue
        k, v = raw.split("=", 1)
        try:
            parts = shlex.split(v)
            data[k] = parts[0] if parts else ""
        except Exception:
            data[k] = v.strip('"').strip("'")
    return data

def svc_active(unit: str) -> bool:
    try:
        r = subprocess.run(["systemctl", "is-active", "--quiet", unit], capture_output=True)
        return r.returncode == 0
    except Exception:
        return False

rows = []
for name, ef in candidates:
    env = parse_env(ef)
    svc = env.get("APP_SYSTEMD_SERVICE") or ("emdash-app" if name == "default" else f"emdash-app-{name}")
    rows.append({
        "instance": name,
        "env_file": str(ef),
        "root_dir": env.get("ROOT_DIR", ""),
        "service": svc,
        "running": svc_active(svc),
        "app_port": env.get("APP_PORT", "3000"),
        "app_url": env.get("APP_PUBLIC_URL", ""),
        "template": env.get("TEMPLATE", ""),
        "db_driver": env.get("DB_DRIVER", "sqlite"),
        "session_driver": env.get("SESSION_DRIVER", "file"),
        "use_caddy": env.get("USE_CADDY", "0") == "1",
    })

print(json.dumps({"schema_version": 1, "instances": rows}, ensure_ascii=False, indent=2))
PY
	)"

	if [[ "${as_json}" == "1" ]]; then
		printf '%s\n' "${out_json}"
		return 0
	fi

	INST_JSON="${out_json}" python3 - <<'PY'
import json, os
rows = json.loads(os.environ["INST_JSON"]).get("instances", [])
if not rows:
    print("No native EmDash instances found.")
else:
    print(f"{'INSTANCE':<16} {'RUNNING':<8} {'PORT':<6} {'DB':<10} {'SERVICE':<22} URL")
    for r in rows:
        inst = r["instance"]
        run = "yes" if r["running"] else "no"
        port = r["app_port"]
        db = r["db_driver"]
        svc = r["service"]
        url = r["app_url"]
        print(f"{inst:<16} {run:<8} {port:<6} {db:<10} {svc:<22} {url}")
PY
}

uninstall_command() {
	local purge_data="0"
	local drop_db="0"
	local assume_yes="0"
	local confirm_instance=""
	local expected_instance="${INSTANCE_SLUG:-default}"

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--purge-data) purge_data="1" ;;
		--drop-db) drop_db="1" ;;
		--yes | -y) assume_yes="1" ;;
		--confirm-instance=*) confirm_instance="${1#--confirm-instance=}" ;;
		--confirm-instance)
			shift
			[[ $# -gt 0 ]] || fail "Missing value for --confirm-instance"
			confirm_instance="$1"
			;;
		*) fail "Unknown uninstall option: $1" ;;
		esac
		shift
	done

	# Safety guard against accidental deletion of system root directories
	local norm_root="${ROOT_DIR%/}"
	case "${norm_root}" in
	"" | "/" | "/data" | "/etc" | "/var" | "/home" | "/usr" | "/root" | "/tmp" | "/opt")
		fail "Refusing to uninstall with unsafe ROOT_DIR: '${ROOT_DIR}'"
		;;
	esac

	# Strong instance-bound confirmation whenever destructive data/DB removal is requested
	if [[ "${purge_data}" == "1" || "${drop_db}" == "1" ]]; then
		if [[ -n "${confirm_instance}" ]]; then
			[[ "${confirm_instance}" == "${expected_instance}" ]] \
				|| fail "--confirm-instance '${confirm_instance}' does not match target instance '${expected_instance}'."
		elif [[ -t 0 ]]; then
			warn "Destructive uninstall requested for instance '${expected_instance}' (purge_data=${purge_data}, drop_db=${drop_db})."
			local typed=""
			read -r -p "Type instance name '${expected_instance}' to confirm permanent deletion: " typed
			[[ "${typed}" == "${expected_instance}" ]] || fail "Confirmation mismatch; uninstall aborted."
		else
			fail "Non-interactive destructive uninstall (--purge-data / --drop-db) requires --confirm-instance '${expected_instance}' (--yes alone is not accepted)."
		fi
	elif [[ "${assume_yes}" != "1" && -t 0 ]]; then
		local ans=""
		read -r -p "Uninstall EmDash service & managed config for instance '${expected_instance}' (data dir ${ROOT_DIR} will be kept)? [y/N]: " ans
		[[ "${ans,,}" == "y" || "${ans,,}" == "yes" ]] || fail "Uninstall aborted by user."
	fi

	acquire_op_lock
	log "Stopping and removing systemd service: ${APP_SYSTEMD_SERVICE}..."
	systemctl stop "${APP_SYSTEMD_SERVICE}" >/dev/null 2>&1 || true
	systemctl disable "${APP_SYSTEMD_SERVICE}" >/dev/null 2>&1 || true
	if [[ -f "${APP_SYSTEMD_UNIT}" ]]; then
		rm -f "${APP_SYSTEMD_UNIT}"
		systemctl daemon-reload >/dev/null 2>&1 || true
	fi

	local cron_file="${BACKUP_CRON_FILE:-/etc/cron.d/emdash-backup}"
	if [[ -f "${cron_file}" ]]; then
		rm -f "${cron_file}"
		log "Removed backup cron: ${cron_file}"
	fi

	# Remove only this instance's Caddy site snippet (never touch user conf.d or other instances)
	if [[ -n "${CADDY_SITE_FILE:-}" && -f "${CADDY_SITE_FILE}" ]]; then
		rm -f "${CADDY_SITE_FILE}"
		log "Removed Caddy site snippet: ${CADDY_SITE_FILE}"
		local remaining_caddy_files=0
		local s=""
		for s in "${CADDY_SITES_DIR}"/*.caddy "${CADDY_CONF_DIR}"/*.caddy; do
			[[ -f "${s}" ]] && remaining_caddy_files=$((remaining_caddy_files + 1))
		done
		if (( remaining_caddy_files > 0 )); then
			local caddy_main="${EMDASH_CADDY_MAIN_FILE:-/etc/caddy/Caddyfile}"
			if command -v caddy >/dev/null 2>&1 && caddy validate --config "${caddy_main}" >/dev/null 2>&1; then
				systemctl reload caddy >/dev/null 2>&1 || true
			fi
		else
			systemctl stop caddy >/dev/null 2>&1 || true
			systemctl disable caddy >/dev/null 2>&1 || true
		fi
	fi

	if [[ "${drop_db}" == "1" && "${DB_DRIVER}" == "postgres" ]]; then
		log "Dropping PostgreSQL database '${PG_DB_NAME}' and role '${PG_DB_USER}'..."
		runuser -u postgres -- psql postgres -v ON_ERROR_STOP=1 <<EOF >/dev/null
SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${PG_DB_NAME}' AND pid <> pg_backend_pid();
DROP DATABASE IF EXISTS "${PG_DB_NAME}";
DROP ROLE IF EXISTS "${PG_DB_USER}";
EOF
	fi

	# Remove instance config files safely without affecting sibling instances
	if [[ -n "${INSTANCE_NAME:-}" ]]; then
		rm -rf "${CONFIG_DIR}"
	else
		rm -f "${APP_ENV_FILE}" "${INSTALL_YAML}"
	fi
	log "Removed instance configuration for '${expected_instance}'."

	if [[ "${purge_data}" == "1" ]]; then
		rm -rf "${norm_root}"
		log "Purged data directory: ${norm_root}"
	else
		log "Preserved data directory: ${norm_root} (pass --purge-data --confirm-instance ${expected_instance} to remove)"
	fi

	release_op_lock

	# Only remove global /usr/local/bin/emdashctl if zero instances remain on the host
	local base_etc="${EMDASH_INSTANCES_BASE_DIR:-/etc/emdash}"
	local bin_path="${EMDASH_BIN_PATH:-/usr/local/bin/emdashctl}"
	local remaining_instances=0
	[[ -f "${base_etc}/emdash.env" ]] && remaining_instances=$((remaining_instances + 1))
	local f=""
	for f in "${base_etc}"/instances/*/emdash.env; do
		[[ -f "${f}" ]] && remaining_instances=$((remaining_instances + 1))
	done
	if (( remaining_instances == 0 )) && [[ -f "${bin_path}" && "${EMDASH_UNINSTALL_KEEP_BIN:-0}" != "1" ]]; then
		rm -f "${bin_path}"
		log "No remaining EmDash instances; removed ${bin_path}."
	fi

	log "Uninstall complete for instance '${expected_instance}'."
}

find_sqlite_to_pg_migrator() {
	local candidate=""
	for candidate in \
		"${ROOT_DIR:-}/lib/migrate-sqlite-to-pg.py" \
		"${EMDASHCTL_SCRIPT_DIR}/lib/migrate-sqlite-to-pg.py"; do
		if [[ -n "${candidate}" && -f "${candidate}" ]]; then
			printf '%s\n' "${candidate}"
			return 0
		fi
	done
	return 1
}

migrate_db_command() {
	local target="${1:-}"
	shift || true
	[[ "${target}" == "sqlite-to-postgres" ]] || fail "Supported migrate-db target: sqlite-to-postgres"
	[[ "${DB_DRIVER}" == "sqlite" ]] || fail "migrate-db sqlite-to-postgres requires current DB_DRIVER=sqlite (got: ${DB_DRIVER})."
	[[ -f "${SQLITE_PATH}" ]] || fail "SQLite database not found: ${SQLITE_PATH}"

	local pg_host="${POSTGRES_HOST:-127.0.0.1}"
	local pg_port="${POSTGRES_PORT:-5432}"
	local pg_db="${PG_DB_NAME:-$([[ -n "${INSTANCE_NAME:-}" ]] && printf 'emdash_%s' "${INSTANCE_NAME//-/_}" || printf 'emdash')}"
	local pg_user="${PG_DB_USER:-${pg_db}}"
	local pg_pass="${PG_DB_PASSWORD:-}"
	local pg_pass_file=""
	local truncate_target="0"
	local dry_run="0"
	local assume_yes="0"

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--pg-host=*) pg_host="${1#--pg-host=}" ;;
		--pg-host) shift; [[ $# -gt 0 ]] || fail "Missing value for --pg-host"; pg_host="$1" ;;
		--pg-port=*) pg_port="${1#--pg-port=}" ;;
		--pg-port) shift; [[ $# -gt 0 ]] || fail "Missing value for --pg-port"; pg_port="$1" ;;
		--pg-db=*) pg_db="${1#--pg-db=}" ;;
		--pg-db) shift; [[ $# -gt 0 ]] || fail "Missing value for --pg-db"; pg_db="$1" ;;
		--pg-user=*) pg_user="${1#--pg-user=}" ;;
		--pg-user) shift; [[ $# -gt 0 ]] || fail "Missing value for --pg-user"; pg_user="$1" ;;
		--pg-password-file=*) pg_pass_file="${1#--pg-password-file=}" ;;
		--pg-password-file) shift; [[ $# -gt 0 ]] || fail "Missing value for --pg-password-file"; pg_pass_file="$1" ;;
		--truncate-target) truncate_target="1" ;;
		--dry-run) dry_run="1" ;;
		--yes | -y) assume_yes="1" ;;
		*) fail "Unknown migrate-db option: $1" ;;
		esac
		shift
	done

	if [[ -n "${pg_pass_file}" ]]; then
		[[ -f "${pg_pass_file}" ]] || fail "PostgreSQL password file not found: ${pg_pass_file}"
		pg_pass="$(tr -d '\r\n' <"${pg_pass_file}")"
	elif [[ -n "${EMDASH_TARGET_PG_PASSWORD:-}" ]]; then
		pg_pass="${EMDASH_TARGET_PG_PASSWORD}"
	fi
	[[ -n "${pg_pass}" ]] || fail "Target PostgreSQL password required (set EMDASH_TARGET_PG_PASSWORD or pass --pg-password-file <file>)."

	local migrator=""
	migrator="$(find_sqlite_to_pg_migrator)" || fail "migrate-sqlite-to-pg.py not found in ${ROOT_DIR}/lib or ${EMDASHCTL_SCRIPT_DIR}/lib"
	command -v psql >/dev/null 2>&1 || fail "psql client is required for sqlite-to-postgres migration."

	# Verify PostgreSQL connectivity
	PGPASSWORD="${pg_pass}" psql -h "${pg_host}" -p "${pg_port}" -U "${pg_user}" -d "${pg_db}" -tAc "SELECT 1" >/dev/null 2>&1 \
		|| fail "Cannot connect to target PostgreSQL (${pg_user}@${pg_host}:${pg_port}/${pg_db}). Ensure PostgreSQL is running and role/database exist."

	# Ensure target DB is empty unless --truncate-target was explicitly passed
	if [[ "${truncate_target}" != "1" ]]; then
		if ! PGPASSWORD="${pg_pass}" python3 "${migrator}" \
			--sqlite-path "${SQLITE_PATH}" \
			--pg-host "${pg_host}" --pg-port "${pg_port}" \
			--pg-user "${pg_user}" --pg-db "${pg_db}" \
			--check-target-empty >/dev/null 2>&1; then
			fail "Target PostgreSQL database '${pg_db}' already contains rows. Use an empty database or pass --truncate-target explicitly."
		fi
	fi

	if [[ "${dry_run}" == "1" ]]; then
		log "Dry-run: SQLite -> PostgreSQL migration plan:"
		log "  Source SQLite: ${SQLITE_PATH}"
		log "  Target PG:     ${pg_user}@${pg_host}:${pg_port}/${pg_db}"
		PGPASSWORD="${pg_pass}" python3 "${migrator}" \
			--sqlite-path "${SQLITE_PATH}" \
			--pg-host "${pg_host}" --pg-port "${pg_port}" \
			--pg-user "${pg_user}" --pg-db "${pg_db}" --dry-run
		log "Dry-run complete. No files or databases were modified."
		return 0
	fi

	if [[ "${assume_yes}" != "1" && -t 0 ]]; then
		local ans=""
		read -r -p "Migrate instance '${INSTANCE_SLUG:-default}' from SQLite to PostgreSQL (${pg_user}@${pg_host}:${pg_port}/${pg_db})? [y/N]: " ans
		[[ "${ans,,}" == "y" || "${ans,,}" == "yes" ]] || fail "Database migration aborted by user."
	fi

	acquire_op_lock
	log "Creating verified pre-migration full backup..."
	local pre_bak=""
	pre_bak="$(create_backup_archive 1 0)"
	log "Pre-migration backup created: ${pre_bak}"

	local rollback_dir=""
	rollback_dir="$(create_site_rollback)"
	[[ -f "${INSTALL_YAML}" ]] && cp -a "${INSTALL_YAML}" "${rollback_dir}/install.yml"

	rollback_db_migration() {
		warn "SQLite -> PostgreSQL migration failed; rolling back site, env, and systemd state to SQLite..."
		systemctl stop "${APP_SYSTEMD_SERVICE}" >/dev/null 2>&1 || true
		restore_site_rollback "${rollback_dir}"
		if [[ -f "${rollback_dir}/install.yml" ]]; then
			cp -a "${rollback_dir}/install.yml" "${INSTALL_YAML}"
		fi
		rm -rf "${rollback_dir}"
		systemctl start "${APP_SYSTEMD_SERVICE}" >/dev/null 2>&1 || true
		release_op_lock
	}

	systemctl stop "${APP_SYSTEMD_SERVICE}" || true

	local pg_user_enc pg_pass_enc pg_db_enc new_db_url
	pg_user_enc="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "${pg_user}")"
	pg_pass_enc="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "${pg_pass}")"
	pg_db_enc="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "${pg_db}")"
	new_db_url="postgres://${pg_user_enc}:${pg_pass_enc}@${pg_host}:${pg_port}/${pg_db_enc}"

	# Switch package.json + astro.config.mjs + emdash.env to PostgreSQL
	DB_DRIVER="postgres"
	POSTGRES_HOST="${pg_host}"
	POSTGRES_PORT="${pg_port}"
	PG_DB_NAME="${pg_db}"
	PG_DB_USER="${pg_user}"
	PG_DB_PASSWORD="${pg_pass}"

	if ! {
		patch_site_package_json_common "${SITE_DIR}" "${PROJECT_NAME:-emdash}" "postgres" "${SESSION_DRIVER}" "${STORAGE_DRIVER}" "${ENABLE_PLUGIN_SANDBOX:-1}" &&
		render_site_astro_config &&
		update_env_value "DB_DRIVER" "postgres" "${APP_ENV_FILE}" &&
		update_env_value "POSTGRES_HOST" "${pg_host}" "${APP_ENV_FILE}" &&
		update_env_value "POSTGRES_PORT" "${pg_port}" "${APP_ENV_FILE}" &&
		update_env_value "PG_DB_NAME" "${pg_db}" "${APP_ENV_FILE}" &&
		update_env_value "PG_DB_USER" "${pg_user}" "${APP_ENV_FILE}" &&
		update_env_value "PG_DB_PASSWORD" "${pg_pass}" "${APP_ENV_FILE}" &&
		update_env_value "DATABASE_URL" "${new_db_url}" "${APP_ENV_FILE}" &&
		chown -R "${APP_RUN_USER}:${APP_RUN_GROUP}" "${SITE_DIR}"
	}; then
		rollback_db_migration
		fail "Failed to reconfigure site for PostgreSQL."
	fi

	log "Rebuilding EmDash site for PostgreSQL..."
	if ! run_as_app_user "HOME='${ROOT_DIR}' npm_config_confirm_modules_purge=false CI=true EMDASH_BUILD_ALLOW_LOCKFILE_UPDATE=1 '${APP_BUILD_SCRIPT}'"; then
		rollback_db_migration
		fail "Application build failed after switching to PostgreSQL."
	fi

	log "Initializing PostgreSQL schema via upstream 'emdash migrate'..."
	# Never bypass migration gate during sqlite-to-postgres: target PG schema MUST be created
	if ! run_upgrade_migration_gate 0; then
		rollback_db_migration
		fail "Upstream PostgreSQL schema initialization failed."
	fi

	log "Migrating rows from SQLite (${SQLITE_PATH}) to PostgreSQL (${pg_db}) with exact row-count verification..."
	# Target DB emptiness was already enforced before `emdash migrate`; passing
	# --truncate-target here cleanly replaces any schema-init seed rows (e.g.
	# _emdash_media_usage_index_status) with the authoritative SQLite rows while
	# keeping _emdash_migrations intact.
	local -a mig_flags=(
		--sqlite-path "${SQLITE_PATH}"
		--pg-host "${pg_host}" --pg-port "${pg_port}"
		--pg-user "${pg_user}" --pg-db "${pg_db}"
		--truncate-target
	)
	if ! PGPASSWORD="${pg_pass}" python3 "${migrator}" "${mig_flags[@]}"; then
		rollback_db_migration
		fail "Data transfer or row-count verification failed; rolled back to SQLite."
	fi

	if [[ -f "${INSTALL_YAML}" ]]; then
		INSTALL_YAML_FILE="${INSTALL_YAML}" PG_DB_NAME_V="${pg_db}" PG_DB_USER_V="${pg_user}" python3 - <<'PY'
import os, re
from pathlib import Path
p = Path(os.environ["INSTALL_YAML_FILE"])
text = p.read_text()
text = re.sub(r"(?m)^(\s*driver:\s*)sqlite$", r"\1postgres", text, count=1)
text = re.sub(r"(?m)^(\s*db_name:\s*).*$", rf"\g<1>{os.environ['PG_DB_NAME_V']}", text, count=1)
text = re.sub(r"(?m)^(\s*db_user:\s*).*$", rf"\g<1>{os.environ['PG_DB_USER_V']}", text, count=1)
p.write_text(text)
PY
	fi

	local health_tries="${EMDASHCTL_HEALTH_TRIES:-60}"
	local setup_tries="${EMDASHCTL_SETUP_TRIES:-20}"
	systemctl start "${APP_SYSTEMD_SERVICE}"
	if ! { wait_http_ok "$(local_health_url)" "${health_tries}" && wait_http_ok "$(local_setup_url)" "${setup_tries}"; }; then
		rollback_db_migration
		fail "Application did not become healthy on PostgreSQL; rolled back to SQLite."
	fi

	rm -rf "${rollback_dir}"
	release_op_lock
	log "SQLite -> PostgreSQL migration completed and verified healthy!"
	log "Original SQLite file preserved at ${SQLITE_PATH} (pre-migration backup: ${pre_bak})."
}

main() {
	local command json_flag="0" deep_flag="0" follow="0"
	parse_lang_args "$@"
	set -- "${PARSED_ARGS[@]}"
	[[ $# -gt 0 ]] || { usage; exit 0; }
	command="$1"
	shift || true
	[[ "${command}" == "-h" || "${command}" == "--help" ]] && { usage; exit 0; }
	if [[ "${command}" == "instances" ]]; then
		instances_command "$@"
		return 0
	fi
	load_env

	case "${command}" in
	status)
		[[ "${1:-}" == "--json" ]] && json_flag="1"
		status_command "${json_flag}"
		;;
	doctor)
		while [[ $# -gt 0 ]]; do
			case "$1" in
			--json) json_flag="1" ;;
			--deep) deep_flag="1" ;;
			*) fail "Unknown doctor option: $1" ;;
			esac
			shift
		done
		doctor_command "${json_flag}" "${deep_flag}"
		;;
	diagnose)
		diagnose_command "$@"
		;;
	smoke)
		[[ "${1:-}" == "--json" ]] && json_flag="1"
		smoke_command "${json_flag}"
		;;
	logs)
		[[ "${2:-}" == "-f" || "${1:-}" == "-f" ]] && follow="1"
		logs_command "${1:-app}" "${follow}"
		;;
	restart)
		restart_command "${1:-app}"
		;;
	backup)
		backup_command "$@"
		;;
	restore)
		[[ $# -ge 1 ]] || fail "restore requires a backup file or --from-s3 <key|latest>"
		restore_command "$@"
		;;
	upgrade)
		[[ $# -ge 1 ]] || fail "$(ct upgrade_supported)"
		upgrade_command "$@"
		;;
	template)
		[[ "${1:-}" == "diff" ]] || fail "Supported template subcommand: diff"
		shift
		template_diff_command "$@"
		;;
	rotate-encryption-key)
		rotate_encryption_key_command "$@"
		;;
	migrate-db)
		[[ $# -ge 1 ]] || fail "Supported migrate-db target: sqlite-to-postgres"
		migrate_db_command "$@"
		;;
	reset-db-password)
		reset_db_password_command
		;;
	uninstall)
		uninstall_command "$@"
		;;
	*)
		fail "$(ct unknown_command): ${command}"
		;;
	esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
