#!/usr/bin/env bash
set -Eeuo pipefail

IFS=$'\n\t'
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0

ENV_FILE="${EMDASH_INSTALL_ENV_FILE:-/etc/emdash/emdash.env}"
INSTANCE_NAME="${EMDASH_INSTANCE:-}"
EMDASH_INSTALL_LANG="${EMDASH_INSTALL_LANG:-en}"
EMDASHCTL_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

normalize_ctl_lang() {
	local input="${1:-en}"
	input="${input//_/-}"
	case "${input,,}" in
	en | english) printf 'en\n' ;;
	ja | jp | japanese) printf 'ja\n' ;;
	ko | korean) printf 'ko\n' ;;
	es | spanish | espanol | español) printf 'es\n' ;;
	de | german | deutsch) printf 'de\n' ;;
	fr | french | francais | français) printf 'fr\n' ;;
	zh-cn | zh-hans | zh-sg | zh) printf 'zh-CN\n' ;;
	zh-tw | zh-hant | zh-hk) printf 'zh-TW\n' ;;
	pt | pt-br | pt-pt | portuguese | portugues | português) printf 'pt\n' ;;
	*) printf 'en\n' ;;
	esac
}

ct() {
	local key="$1"
	local lang="${EMDASH_INSTALL_LANG:-en}"
	case "${key}" in
	usage_title) case "${lang}" in en) printf 'Usage:' ;; ja) printf '使い方:' ;; ko) printf '사용법:' ;; es) printf 'Uso:' ;; de) printf 'Verwendung:' ;; fr) printf 'Utilisation :' ;; zh-CN) printf '用法:' ;; zh-TW) printf '用法:' ;; pt) printf 'Uso:' ;; esac ;;
	missing_env) case "${lang}" in en) printf 'Missing environment file' ;; ja) printf '環境ファイルが見つかりません' ;; ko) printf '환경 파일이 없습니다' ;; es) printf 'Falta el archivo de entorno' ;; de) printf 'Umgebungsdatei fehlt' ;; fr) printf 'Fichier d’environnement manquant' ;; zh-CN) printf '缺少环境文件' ;; zh-TW) printf '缺少環境檔' ;; pt) printf 'Arquivo de ambiente ausente' ;; esac ;;
	unknown_command) case "${lang}" in en) printf 'Unknown command' ;; ja) printf '不明なコマンド' ;; ko) printf '알 수 없는 명령' ;; es) printf 'Comando desconocido' ;; de) printf 'Unbekannter Befehl' ;; fr) printf 'Commande inconnue' ;; zh-CN) printf '未知命令' ;; zh-TW) printf '未知命令' ;; pt) printf 'Comando desconhecido' ;; esac ;;
	backup_complete) case "${lang}" in en) printf 'Backup complete' ;; ja) printf 'バックアップ完了' ;; ko) printf '백업 완료' ;; es) printf 'Copia completada' ;; de) printf 'Backup abgeschlossen' ;; fr) printf 'Sauvegarde terminée' ;; zh-CN) printf '备份完成' ;; zh-TW) printf '備份完成' ;; pt) printf 'Backup concluído' ;; esac ;;
	restore_complete) case "${lang}" in en) printf 'Restore complete' ;; ja) printf '復元完了' ;; ko) printf '복원 완료' ;; es) printf 'Restauración completa' ;; de) printf 'Wiederherstellung abgeschlossen' ;; fr) printf 'Restauration terminée' ;; zh-CN) printf '恢复完成' ;; zh-TW) printf '還原完成' ;; pt) printf 'Restauração concluída' ;; esac ;;
	reset_only_postgres) case "${lang}" in en) printf 'reset-db-password is only supported for PostgreSQL' ;; ja) printf 'reset-db-password は PostgreSQL のみ対応です' ;; ko) printf 'reset-db-password는 PostgreSQL만 지원합니다' ;; es) printf 'reset-db-password solo es compatible con PostgreSQL' ;; de) printf 'reset-db-password wird nur für PostgreSQL unterstützt' ;; fr) printf 'reset-db-password est pris en charge uniquement pour PostgreSQL' ;; zh-CN) printf '当前仅 PostgreSQL 支持 reset-db-password' ;; zh-TW) printf '目前僅 PostgreSQL 支援 reset-db-password' ;; pt) printf 'reset-db-password só é compatível com PostgreSQL' ;; esac ;;
	upgrade_supported) case "${lang}" in en) printf 'Supported upgrade targets: app | caddy-config' ;; ja) printf '対応する upgrade 対象: app | caddy-config' ;; ko) printf '지원되는 upgrade 대상: app | caddy-config' ;; es) printf 'Objetivos compatibles: app | caddy-config' ;; de) printf 'Unterstützte Upgrade-Ziele: app | caddy-config' ;; fr) printf 'Cibles prises en charge : app | caddy-config' ;; zh-CN) printf '支持的 upgrade 目标: app | caddy-config' ;; zh-TW) printf '支援的 upgrade 目標: app | caddy-config' ;; pt) printf 'Alvos suportados: app | caddy-config' ;; esac ;;
	runtime_label) case "${lang}" in en) printf 'Runtime' ;; ja) printf '実行方式' ;; ko) printf '런타임' ;; es) printf 'Modo' ;; de) printf 'Laufzeit' ;; fr) printf 'Runtime' ;; zh-CN) printf '运行方式' ;; zh-TW) printf '執行方式' ;; pt) printf 'Runtime' ;; esac ;;
	url_label) case "${lang}" in en) printf 'URL' ;; ja) printf 'URL' ;; ko) printf 'URL' ;; es) printf 'URL' ;; de) printf 'URL' ;; fr) printf 'URL' ;; zh-CN) printf 'URL' ;; zh-TW) printf 'URL' ;; pt) printf 'URL' ;; esac ;;
	app_running_label) case "${lang}" in en) printf 'App running' ;; ja) printf 'アプリ稼働' ;; ko) printf '앱 실행 상태' ;; es) printf 'App activa' ;; de) printf 'App läuft' ;; fr) printf 'App active' ;; zh-CN) printf '应用运行' ;; zh-TW) printf '應用執行中' ;; pt) printf 'App em execução' ;; esac ;;
